# This file documents every environment variable used across the monorepo.
# Actual per-app examples live in apps/web/.env.example and apps/api/.env.example.

# ---- Supabase (shared) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Database (Prisma -> Supabase Postgres) ----
DATABASE_URL=
DIRECT_URL=

# ---- API (apps/api) ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Web (apps/web, must be prefixed VITE_) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000

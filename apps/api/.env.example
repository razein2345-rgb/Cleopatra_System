NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres connection strings (Prisma)
DATABASE_URL=postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres

# Supabase project credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cleopatra AI (Phase 1, docs/AI/CLEOPATRA_AI_IMPLEMENTATION_PLAN.md) — read-only assistant.
# Owner's correction (2026-09-09): local-only validation against a
# locally-installed Ollama instance — no hosted LLM API key of any kind,
# no Cleopatra business data ever leaves this machine. Both vars are
# optional; the values below are also the built-in defaults.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

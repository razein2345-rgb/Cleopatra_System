NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres connection strings (Prisma)
DATABASE_URL=postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres

# Supabase project credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cleopatra AI (Phase 1, docs/AI/CLEOPATRA_AI_IMPLEMENTATION_PLAN.md) — read-only assistant.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

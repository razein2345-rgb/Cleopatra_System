/// FEATURE-007 WF-B. Matches `WorkflowTemplate.code` for the 4 tracks
/// seeded by WF-A (prisma/seed.ts's `DEFAULT_WORKFLOW_TEMPLATES`) — chosen
/// explicitly by staff at order-creation time, never inferred from item
/// kind (owner decision, 2026-08-12: "بنفرق على حسب الطلب من الأول" — the
/// customer's chosen track, not a heuristic, is what routes the order).
enum ProductionTrack {
  OFFSET
  DIGITAL
  BOARDS_SIGNAGE
  OTHER_PRODUCTS
  /// FEATURE-009 (2026-08-13) — reserved so a services-only or ready-
  /// products-only order can eventually get its own dedicated
  /// WorkflowTemplate/Work Order shape; no template exists for either yet
  /// (owner: "جهز الـarchitecture فقط... لا تخترع لها قواعد من عندك") —
  /// `createWorkOrder` already returns a clean 400 NO_PUBLISHED_TEMPLATE
  /// if one is picked before a template is defined.
  SERVICES
  READY_PRODUCTS
  /// system_specifications_v2.md §2.4/§7-A.6 "Sublimation & Gifts" — thermal
  /// printing for mugs/t-shirts/caps, its own dedicated machines separate
  /// from every other track. Was entirely unrepresented before (owner,
  /// 2026-08-16: "أضف المسارات المذكورة جميعًا... كطباعة التيشرتات").
  SUBLIMATION_GIFTS
}

/// Owner (2026-08-20, "محتاج تشوف وتعمل سيرش ازاي هتعدل الديجيتال بحيث
/// يتماشي مع كل الاوردرات") — the digital track's item doesn't always print
/// on the quarter-sheet machine (Yield-packed pieces); "الداخلي" (a book's
/// interior pages, for example) usually prints on a separate machine that
/// runs plain A4/A3 sheets directly, one copy = one whole sheet, no
/// packing/Yield concept at all. `QUARTER` is the pre-existing mechanism
/// (`DigitalCostInput`'s Yield math), unchanged; `A4_DIRECT`/`A3_DIRECT`
/// are new.
enum DigitalPrintBasis {
  QUARTER
  A4_DIRECT
  A3_DIRECT
}

/// Owner (2026-08-20, "الألوان مقابل الأبيض والأسود — سعرين منفصلين تمامًا
/// لكل حالة") — a full second price table, not a percentage of the color
/// price.
enum DigitalColorMode {
  COLOR
  BW
}

/// Owner (2026-08-20, "عندي في الإعدادات سعر للطباعة وجه، وسعر للطباعة وجه
/// وظهر") — same treatment as color: a fully separate price table per
/// side-count, not a markup added on top of the single-sided price.
enum DigitalSides {
  SINGLE
  DOUBLE
}

/// @deprecated FEATURE-004 M1. See `WorkOrder.productionStatus`'s own doc
/// comment — a hardcoded, Printing-specific pipeline the Workflow Engine
/// replaces. Kept only because the field using it is kept; never
/// referenced by new code.
enum WorkOrderProductionStatus {
  WAITING
  DESIGN
  PREPRESS
  PLATE_MAKING
  PRINTING
  FINISHING
  QUALITY_CHECK
  READY_FOR_DELIVERY
  COMPLETED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

/// "تصميم واحد بمتغيرات إنتاج متعددة" (2026-08-19, owner: "أقدر أعرف A4
/// خلصت والA5 لسه") — per-`OrderItem` production progress, independent of
/// the shared `WorkOrder`/`WorkflowInstance` stage it belongs to (owner's
/// explicit decision: no separate Work Order per size/quantity variant,
/// but each variant must stay independently trackable). Distinct from
/// `StageInstanceStatus` on purpose — this tracks "how much of this one
/// item's quantity is physically done," not "what stage is the whole job
/// in."
enum OrderItemProductionStatus {
  WAITING
  IN_PROGRESS
  DONE
}

enum PaymentMethod {
  CASH
  VODAFONE_CASH
  INSTAPAY
  BANK_ACCOUNT
}

enum TreasuryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TreasurySourceType {
  MANUAL
  INVOICE_PAYMENT
  EMPLOYEE_ADVANCE
  EMPLOYEE_ADVANCE_REPAYMENT
  /// Owner (2026-08-20, "مش محتاجه يتعمله فاتورة خالص") — paired atomically
  /// with an `OUT` StockMovement, no Order/invoice involved at all. See
  /// `TreasuryEntry.stockMovementId`.
  QUICK_SALE
  /// Owner (2026-08-20, "لو لا طب هنعمل ده ازاي") — a manual "صرف مرتب"
  /// action, paired atomically with a `SalaryPayment`. See
  /// `TreasuryEntry.salaryPaymentId`.
  SALARY_PAYMENT
  /// Owner (2026-08-23, "عند الخطأ في بيع صنف من المخزون: إرجاع الصنف
  /// الخطأ للمخزون") — a cash refund for a returned `INVENTORY_RETAIL`
  /// item, paired atomically with an `OrderItemReturn` (and its own `IN`
  /// StockMovement via `restockForOrderItem`). See
  /// `TreasuryEntry.orderItemReturnId`.
  RETURN
}

/// FEATURE-008 (2026-08-13) — how often an employee is paid; drives which
/// unit `StaffProfile.baseSalary` is denominated in.
enum PayFrequency {
  WEEKLY
  MONTHLY
}

/// FEATURE-008 — an advance repayment either returns physical cash (hits
/// Treasury as INCOME, same atomic pattern as an invoice payment) or is
/// deducted from the employee's salary (no cash movement — this system
/// doesn't run payroll itself, so a salary deduction is simply recorded,
/// not paid out through Treasury).
enum AdvanceRepaymentMethod {
  CASH
  SALARY_DEDUCTION
}

enum TenderStatus {
  OPEN
  SUBMITTED
  WON
  LOST
}

enum MaterialCategory {
  PAPER
  INK
  PLATE
  FINISHING
  CONSUMABLE
  /// system_specifications_v2.md (2026-08-16, owner: "مخزون جاهز عندي،
  /// والعميل ياخدها فورًا") — held-stock ready-made merchandise bought in
  /// already finished (stationery, external books, ...), sold directly off
  /// the shelf rather than consumed by a production formula. Distinct from
  /// the other 5 categories, which all feed pricing/consumption formulas —
  /// this one only needs `salePrice` + `barcode` + the stock engine already
  /// built for the rest of InventoryItem.
  READY_MADE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  /// FEATURE-002 M2. Distinct from STATUS_CHANGE: which contact is the
  /// primary is a relationship/exclusivity change, not a status toggle —
  /// kept separate so "who was primary when" stays independently queryable.
  PRIMARY_CHANGED
  /// FEATURE-002 M3. Same rationale as PRIMARY_CHANGED, for the analogous
  /// "default address per type" exclusivity change — kept as its own value
  /// per the explicit M3 requirement, rather than reusing PRIMARY_CHANGED,
  /// since the two flags belong to different entities and audit queries
  /// should be able to filter for one without the other.
  DEFAULT_CHANGED
  /// FEATURE-002 M4. Per-entity CRUD action names for the Category/Tag
  /// admin catalogs — an explicit, deliberate exception to the
  /// CREATE/UPDATE/DELETE + entityType convention used everywhere else in
  /// this feature (see 03_IMPLEMENT.md M2's "wouldn't scale to future
  /// entities" note): the M4 requirement specifies these exact action
  /// names, so they are used as specified rather than folded into the
  /// generic values.
  CREATE_CATEGORY
  UPDATE_CATEGORY
  DELETE_CATEGORY
  CREATE_TAG
  UPDATE_TAG
  DELETE_TAG
  /// A partner's Category assignment changed — relationship/exclusivity
  /// change, same rationale as PRIMARY_CHANGED/DEFAULT_CHANGED, distinct
  /// from a generic STATUS_CHANGE/UPDATE on the partner record itself.
  CATEGORY_CHANGED
  /// A partner's Tag set changed (any add/remove) — one audit entry per
  /// assignment call, not one per tag, since tags are set as a whole.
  TAGS_CHANGED
  /// FEATURE-002 M5. A note was pinned — kept distinct from generic UPDATE
  /// since pinning is a relationship/visibility change (same rationale as
  /// PRIMARY_CHANGED/DEFAULT_CHANGED/CATEGORY_CHANGED), not a content edit.
  PIN
  /// The inverse of PIN — kept as its own value rather than reusing PIN
  /// with a payload flag, so "when was this unpinned" stays independently
  /// queryable, consistent with the PRIMARY_CHANGED/DEFAULT_CHANGED style.
  UNPIN
  /// FEATURE-003. An internal approval decision on a Quotation changed —
  /// kept distinct from STATUS_CHANGE for the same reason PIN/UNPIN and
  /// CATEGORY_CHANGED are distinct from generic UPDATE: approval and the
  /// customer-facing workflow status are independent concepts (see
  /// QuotationApprovalState's doc comment) and audit queries should be
  /// able to filter for one without the other.
  APPROVAL_CHANGED
  /// ADR 0028 (Last-Active-Administrator Safety Rule). Recorded by
  /// `AdminSafetyService` itself whenever it rejects an operation that
  /// would orphan the system — never by the calling controller — so
  /// every current and future caller gets this for free. `newValue`
  /// carries `{ reason: 'LAST_ACTIVE_ADMIN', operation }`; a distinct
  /// value from DELETE/UPDATE/STATUS_CHANGE specifically so future
  /// security reporting can filter for "rejected, dangerous attempts"
  /// as its own category, independent of what succeeded.
  SECURITY_REJECTION
}

/// FEATURE-002. Lifecycle stage — distinct from PartnerRole (what capacity
/// a partner acts in). PROSPECT is a stage every partner starts in, not a
/// role, so it is not duplicated in PartnerRole.
enum PartnerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  BLOCKED
}

/// PRODUCT_ROADMAP.md §2 "المرحلة الأولى" (CRM Phase 1's cheapest first
/// step) — a fixed, code-defined picklist, same class as PartnerStatus/
/// PartnerRole above, not an admin-managed catalog (TreasuryCategory/
/// PartnerTag's pattern) — the roadmap's own phrasing ("قائمة بسيطة")
/// matches the fixed-enum precedent, and no one asked for this list to be
/// editable from Settings.
enum LeadSource {
  REFERRAL
  SOCIAL_MEDIA
  WALK_IN
  PHONE_INQUIRY
  WEBSITE
  REPEAT_CUSTOMER
  OTHER
}

/// PRODUCT_ROADMAP.md §2 ("المرحلة الثانية") — a simple pipeline, not a
/// configurable/admin-managed catalog (matches the roadmap's own "بمراحل
/// بسيطة" wording): a lead moves forward through NEW → CONTACTED →
/// QUALIFIED, then ends at exactly one of CONVERTED or REJECTED — both
/// terminal, never re-opened.
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  REJECTED
}

/// Owner, 2026-08-13 — only meaningful on an individual BusinessPartner
/// (isIndividual: true); picks the printed-document salutation ("السيد"/
/// "السيدة" instead of the company-style "السادة").
enum Gender {
  MALE
  FEMALE
}

/// FEATURE-002. What capacity a partner acts in; a partner may hold more
/// than one at once (see 01_ANALYSIS.md's Approved decision).
enum PartnerRole {
  CUSTOMER
  SUPPLIER
  GOVERNMENT
  SCHOOL
  HOSPITAL
  COMPANY
  PRINTING_HOUSE
  INTERNAL_DEPARTMENT
}

/// FEATURE-002 M2. Nullable on ContactPerson — "no preference recorded" is
/// a valid, distinct state from any specific channel.
enum PreferredContactMethod {
  PHONE
  MOBILE
  WHATSAPP
  EMAIL
}

/// FEATURE-002 M3.
enum AddressType {
  BILLING
  SHIPPING
  OFFICE
  FACTORY
  BRANCH
  WAREHOUSE
  REGISTERED
  OTHER
}

// ---------------------------------------------------------------------------
// Branch & document numbering (Requirements 1, 8, 11)
// ---------------------------------------------------------------------------

model Branch {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  code          String  @unique
  address       String?
  isDefault     Boolean @default(false)
  /// FEATURE-007 (2026-08-12, owner: "لما اختار فرع بيت الطباعة يطلعلي فاتورة فيها لوجو بيت الطباعة" / "يظهرلي بيانات بيت الطباعة أو بيانات كليوباترا") — per-branch letterhead identity. Each null field falls back to the matching global `Setting` field, so a branch with none of its own still prints the company's normal letterhead.
  logoUrl       String?
  phone         String?
  email         String?
  /// FEATURE-007 (2026-08-12, owner: "عايز اضيف كمان الرقم الأرضي وصفحة الفيسبوك تحت في البيانات بتاعت عرض السعر") — landline (as opposed to `phone`, the mobile/WhatsApp-style number) and Facebook page link, both falling back to the matching global `Setting` field like the rest of this identity block.
  landlinePhone String?
  facebookUrl   String?
  /// FEATURE-007 (2026-08-12, owner: "ختم بيت الطباعة بردو لازم يترفع في تفاصيل فرع بيت الطباعه") — per-branch stamp/seal image, same fallback-to-global-Setting behavior as logoUrl.
  stampUrl      String?
  /// FEATURE-007 (2026-08-13, owner: "ضيفها كا حقل منفصل") — per-branch tagline (e.g. "للدعاية والإعلان"), same fallback-to-global-Setting behavior as the rest of this identity block.
  tagline       String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff               StaffProfile[]
  userBranchAccess    UserBranchAccess[]
  businessPartners    BusinessPartner[]
  orders              Order[]
  quotations          Quotation[]
  workOrders          WorkOrder[]
  treasuryEntries     TreasuryEntry[]
  documentSequences   DocumentSequence[]
  stockLevels         StockLevel[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  employeeAdvances    EmployeeAdvance[]
  salaryPayments      SalaryPayment[]
  leads               Lead[]
  attendanceEntries   AttendanceEntry[]
  fieldAssignments    FieldAssignment[]
  treasuryDayClosures TreasuryDayClosure[]
  machines            Machine[]
  orderTemplates      OrderTemplate[]
  orderItemReturns    OrderItemReturn[]

  @@index([isDeleted])
}

/// One row per (branch, document type, year). `lastNumber` is incremented
/// atomically in the same transaction that creates the document (Phase 6/7/8);
/// never read-then-incremented in application code. Formatted display value is
/// `{prefix}-{year}-{lastNumber padded to 6 digits}`, e.g. CLP-INV-2026-000001.
model DocumentSequence {
  id           String       @id @default(uuid()) @db.Uuid
  branchId     String       @db.Uuid
  branch       Branch       @relation(fields: [branchId], references: [id])
  documentType DocumentType
  year         Int
  prefix       String
  lastNumber   Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, documentType, year])
}

// ---------------------------------------------------------------------------
// Settings & catalog (Phase 1 — API/UI built now)
// Field list mirrors legacy DEFAULT_SETTINGS exactly (LEGACY_ANALYSIS §4).
// Singleton row; not soft-deletable (system config, never deleted).
// ---------------------------------------------------------------------------

model Setting {
  id String @id @default(uuid()) @db.Uuid

  zincPrice               Decimal @db.Decimal(12, 2)
  printRunPrice           Decimal @db.Decimal(12, 2)
  numberingRunPrice       Decimal @db.Decimal(12, 2)
  envelopeDesignPrice     Decimal @db.Decimal(12, 2)
  envelopePrintRunPrice   Decimal @db.Decimal(12, 2)
  envelopeZincPrice       Decimal @db.Decimal(12, 2)
  designPrice             Decimal @db.Decimal(12, 2)
  wasteSheetsDefault      Int
  profitPercent           Decimal @db.Decimal(6, 3)
  /// FEATURE-007 PE-E — VAT percentage applied when `Order.vatOn`/
  /// `Quotation.vatOn` is toggled on. Previously only the boolean toggle
  /// existed with no configurable rate (`vatAmount` was caller-supplied).
  /// Business-logic prompt §6.1 default: 14%.
  vatRate                 Decimal @default(14) @db.Decimal(5, 2)
  notebookThreshold       Int
  looseThreshold          Int
  sellophanePricePerSheet Decimal @db.Decimal(12, 2)
  logoUrl                 String?

  boardsBannerNoDesign         Decimal @db.Decimal(12, 2)
  boardsBannerWithDesign       Decimal @db.Decimal(12, 2)
  boardsVinylPrintCutNoSello   Decimal @db.Decimal(12, 2)
  boardsVinylPrintCutWithSello Decimal @db.Decimal(12, 2)
  boardsVinylNormalNoSello     Decimal @db.Decimal(12, 2)
  boardsVinylNormalWithSello   Decimal @db.Decimal(12, 2)
  boardsFlex                   Decimal @db.Decimal(12, 2)
  boardsSeasro                 Decimal @db.Decimal(12, 2)
  boardsGapMM                  Decimal @db.Decimal(6, 2)

  /// system_specifications_v2.md §13.3 — Digital printing Yield-based
  /// costing. Quarter-sheet dimensions are configurable (rule 15) rather
  /// than hardcoded, defaulting to the spec's 50×35cm, in case the feed
  /// size changes with a different machine.
  digitalPrintPricePerQuarter     Decimal @default(0) @db.Decimal(12, 2)
  digitalSellophanePricePerQuarter Decimal @default(0) @db.Decimal(12, 2)
  digitalQuarterWidthCm            Decimal @default(50) @db.Decimal(6, 2)
  digitalQuarterHeightCm           Decimal @default(35) @db.Decimal(6, 2)

  /// FEATURE-006 — business identity for document headers (Quotation/
  /// Invoice/Work Order printing). All nullable/additive; logoUrl above is
  /// reused as-is (no upload endpoint exists anywhere in this codebase —
  /// confirmed by inspection — so this stays a plain URL field, not a file
  /// upload, per the explicit decision not to invent upload architecture).
  businessNameAr              String?
  businessNameEn              String?
  /// FEATURE-007 (2026-08-12, owner: "عايز تحت الإسم بتاع المكان يكون في وصف للدعاية والإعلان مش نفس خط الإسم") — a short tagline under the business name on documents (e.g. "للدعاية والإعلان"), rendered in a distinct, lighter style from the name itself.
  businessTagline             String?
  address                     String?
  phone                       String?
  email                       String?
  website                     String?
  taxNumber                   String?
  commercialRegisterNumber    String?
  /// FEATURE-007 (2026-08-12, owner: "عايز اضيف صورة الختم فوق وتفضلو بقبول وافر الإحترام") — company stamp/seal image, printed above the closing line on Quotation/Work Order documents.
  stampUrl                    String?
  /// FEATURE-007 (2026-08-12, owner: "عايز اضيف كمان الرقم الأرضي وصفحة الفيسبوك تحت في البيانات بتاعت عرض السعر") — landline (as opposed to `phone`, the mobile/WhatsApp-style number) and Facebook page link, shown in the document footer.
  landlinePhone               String?
  facebookUrl                 String?
  /// FEATURE-007 (2026-08-12, owner: "الختم المفروض اكون مخير إنه يظهر في الفاتورة ولا لا زي اللوجو والإسم") — the Invoice always omits logo/name/watermark (a deliberate, non-configurable code decision — a plain invoice, not promotional), but the stamp is a real owner choice. Off by default, matching the invoice's existing "plain" default.
  showStampOnInvoice          Boolean @default(false)
  /// FEATURE-007 (2026-08-12, owner: "عايز اوبشن في عرض السعر إني اشيل التاريخ خالص او يكون موجود اللي هو تاريخ إصدار عرض السعر نفسه") — whether the quotation's own issue date prints at all. On by default (unchanged existing behavior).
  showQuotationDate           Boolean @default(true)
  /// FEATURE-007 (2026-08-13, owner: "التوقيع ... والسيريل نمبر بتاع العرض حابب كل التفاصيل دي تكون داخليه متظهرش على العرض اللي هيتطبع للعميل") — the signature area and the quotation's own printed serial number, both off by default (internal-only, never shown to the customer copy).
  showQuotationSignatureArea  Boolean @default(false)
  showQuotationDocumentNumber Boolean @default(false)
  /// FEATURE-008 (2026-08-13, owner: "في الفاتورة مش عايز يظهر فيها العنوان والرقم الأرضي والإيميل ورقم التليفون وصفحة الفيس إلا بإختياري يعني يكون ليهم check box برضو") — off by default, each independently toggleable, Invoice-specific (Quotation/Work Order keep their own template-config-driven display, unaffected).
  showInvoiceAddress          Boolean @default(false)
  showInvoicePhone            Boolean @default(false)
  showInvoiceEmail            Boolean @default(false)
  showInvoiceLandline         Boolean @default(false)
  showInvoiceFacebook         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Document Templates & Printing (FEATURE-006). Versioned exactly like
// WorkflowTemplate (FEATURE-004): code stays implicit per documentType +
// name, `version`/`previousVersionId` chain, `publishedAt` null = draft/
// editable, non-null = immutable. A Quotation/Order/WorkOrder's
// `documentTemplateId` points at one exact version forever — editing a
// template publishes a new version, never mutates an existing row, so a
// document that already froze its `documentSnapshot` (see those models
// below) is never affected by a later edit.
// ---------------------------------------------------------------------------

/// `config` holds the customizable header/footer/section-visibility/terms/
/// signature-area shape — one flexible field, the same precedent as
/// StageInstance.variableValues, rather than dozens of rigid columns.
/// "Exactly one default per documentType" reuses the exclusivity-lock
/// pattern from partnerChildEntity.ts (generalized to a lock-key form,
/// since there is no natural parent row to lock the way BusinessPartner
/// is for ContactPerson/PartnerAddress — see setExclusiveDefaultByKey).
model DocumentTemplate {
  id           String       @id @default(uuid()) @db.Uuid
  documentType DocumentType
  name         String
  config       Json

  isDefault Boolean @default(false)

  version           Int               @default(1)
  previousVersionId String?           @unique @db.Uuid
  previousVersion   DocumentTemplate? @relation("DocumentTemplateVersionChain", fields: [previousVersionId], references: [id])
  nextVersion       DocumentTemplate? @relation("DocumentTemplateVersionChain")
  publishedAt       DateTime?

  quotations Quotation[]
  orders     Order[]
  workOrders WorkOrder[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentType], where: { isDefault: true, isDeleted: false })
  @@index([isDeleted])
  @@index([documentType])
}

/// Replaces legacy `settings.families`. "Protected" sizes (LEGACY_ANALYSIS
/// §2/§9 — sizes structurally relied on by the tiered/numbering calculation
/// engine) are a computed flag in the API layer, derived from the GROUPS /
/// REAL_SIZES constants ported verbatim in Phase 4 — not stored here.
model SizeFamily {
  id    String    @id @default(uuid()) @db.Uuid
  key   String    @unique
  label String
  base  SheetBase

  entries SizeFamilyEntry[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
}

model SizeFamilyEntry {
  id             String     @id @default(uuid()) @db.Uuid
  familyId       String     @db.Uuid
  family         SizeFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  label          String
  piecesPerSheet Decimal    @db.Decimal(10, 3)
  sortOrder      Int        @default(0)

  @@unique([familyId, label])
}

/// Replaces legacy `settings.sheetTypes.{gayer,regular}`. `unit` is reserved
/// for future inventory tracking (Requirement 9) — unused by any calculator.
model SheetType {
  id    String        @id @default(uuid()) @db.Uuid
  base  SheetBase
  name  String
  price Decimal       @db.Decimal(12, 2)
  unit  InventoryUnit @default(SHEET)

  inventoryItem InventoryItem?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
}

model ReadyProduct {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  price      Decimal            @db.Decimal(12, 2)
  /// FEATURE-009 (2026-08-13, owner: "لا تبني Products جاهزة على افتراض أن
  /// كل المنتجات يتم إنتاجها داخل المطبعة... يجب أن يكون الـarchitecture
  /// قادرًا على تحديد مصدر تنفيذ المنتج") — metadata only, no pricing/
  /// workflow behavior attached yet. Nullable: existing products stay
  /// unset until an admin fills this in.
  sourceType ProductSourceType?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // FEATURE-003 M1.
  quotationItems QuotationItem[]

  @@index([isDeleted])
}

model Service {
  id       String          @id @default(uuid()) @db.Uuid
  name     String
  price    Decimal         @db.Decimal(12, 2)
  category ServiceCategory

  // FEATURE-003 M1.
  quotationItems QuotationItem[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
}

// ---------------------------------------------------------------------------
// Identity & Access Management (Phase 2 — API/UI built now)
//
// Authentication itself (credential storage/hashing, session/JWT issuance)
// is fully delegated to Supabase Auth (see ADR 0005, ADR 0021) — this system
// never stores or sees a password. StaffProfile is the application-level
// identity record, linked 1:1 to a Supabase Auth user via `supabaseUserId`.
//
// Authorization is true DB-driven RBAC (ADR 0022): a StaffProfile has one or
// more Roles (UserRole), each Role has a set of Permissions (RolePermission).
// Nothing about "what a role can do" is hardcoded in application code — the
// permission check is always a query against these tables. `Permission.key`
// follows a `<module>.<action>` convention (e.g. `partners.view`) with two
// wildcard forms: `<module>.*` (everything in one module) and `*` (superuser,
// granted only to the seeded Super Admin role).
// ---------------------------------------------------------------------------

model StaffProfile {
  id             String    @id @default(uuid()) @db.Uuid
  supabaseUserId String    @unique @db.Uuid
  name           String
  /// FEATURE-001.2 fix (2026-08-13, found live) — plain `@unique` used to
  /// permanently block an email once its StaffProfile was soft-deleted,
  /// exactly like ContactPerson's "only one Primary Contact" partial
  /// index above — see the `@@unique(..., where: ...)` below instead.
  email          String
  phone          String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  /// Owner (2026-08-20, "محتاج اشوف مين الموظف الأكتيف على السيستم") —
  /// "currently online" tracking, distinct from `lastLoginAt` (which only
  /// ever reflects the moment of sign-in). Updated by `requireAuth`
  /// (throttled — at most once/minute per staff member, fire-and-forget)
  /// on every authenticated request; the UI treats "within the last few
  /// minutes" as "online now" since there is no real session/heartbeat
  /// mechanism (auth is stateless Supabase JWT verification per request).
  lastActiveAt   DateTime?

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  /// FEATURE-004 M1. Home department — nullable since existing staff have
  /// none yet, and not every role needs one (Sales/Admin have no
  /// production-floor queue). Mirrors `branchId`'s "home + explicit grants"
  /// shape exactly (see `UserDepartmentAccess`).
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  /// FEATURE-008 (2026-08-13, owner: "منهم من يقبض بالأسبوع ومنهم من يقبض
  /// بالشهر") — HR fields layered onto the existing IAM StaffProfile
  /// rather than a parallel Employee model (this row is already the one
  /// "employee" record in the system). All nullable: existing staff have
  /// none set yet, and not every account (e.g. a system/admin-only login)
  /// needs them.
  position       String?
  hireDate       DateTime?
  payFrequency   PayFrequency?
  /// The pay amount per `payFrequency`'s own cycle (a weekly rate if
  /// WEEKLY, a monthly rate if MONTHLY) — never both at once, so no
  /// separate weekly/monthly columns.
  baseSalary     Decimal?      @db.Decimal(12, 2)
  /// Owner (2026-08-20, "عندي موظف بيبدأ قبض من يوم 9 في الشهر مش من يوم
  /// 1") — day-of-month the MONTHLY pay cycle starts on, per employee.
  /// Null = cycle starts on the 1st (the original calendar-month
  /// behavior, unchanged for every existing employee). Ignored for
  /// WEEKLY staff. Clamped against short months (e.g. day 31 in
  /// February) at read time in `employeePayrollService.ts`, not here.
  payDayOfMonth  Int?
  /// FEATURE-008 (2026-08-13, owner: "يحسب مرتب الناس عن طريق الحضور
  /// والإنصراف عن طريق الساعات") — shift schedule used to derive the
  /// hourly rate (baseSalary ÷ scheduled work days in the pay period ÷
  /// shift hours) and to detect lateness/early-leave/overtime against
  /// AttendanceEntry. "HH:MM", 24h, no per-employee timezone (single-branch
  /// business, matches every other time-of-day usage in this codebase).
  shiftStartTime String?
  shiftEndTime   String?
  /// Weekday indices this employee is scheduled to work (0 = Sunday … 6 =
  /// Saturday, JS/`Date.getUTCDay()` convention used everywhere else in
  /// this codebase's date math). Empty/null = schedule not configured yet
  /// — payroll-by-hours simply doesn't apply until it is.
  workingDays    Int[]

  /// FEATURE-013 (2026-08-14, owner: "الموظف يكتب اسمه ورقمه السري") — the
  /// Kiosk attendance PIN, hashed (`crypto.scryptSync` + a per-user salt,
  /// stored together as one string — no new hashing dependency). Null for
  /// every staff member who doesn't use the Kiosk (e.g. برينتنج هاوس's
  /// single employee, who keeps checking in via their own login).
  attendancePinHash String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                      UserRole[]
  branchAccess               UserBranchAccess[]
  departmentAccess           UserDepartmentAccess[]
  businessPartnersAsSalesRep BusinessPartner[]
  orders                     Order[]
  quotations                 Quotation[]
  treasuryEntries            TreasuryEntry[]
  attachments                Attachment[]
  auditLogs                  AuditLog[]
  assignedStageInstances     StageInstance[]
  workflowEvents             WorkflowEvent[]
  advancesReceived           EmployeeAdvance[]          @relation("EmployeeAdvanceStaff")
  advancesRecorded           EmployeeAdvance[]          @relation("EmployeeAdvanceRecordedBy")
  advanceRepaymentsRecorded  EmployeeAdvanceRepayment[] @relation("EmployeeAdvanceRepaymentRecordedBy")
  salaryPaymentsReceived     SalaryPayment[]            @relation("SalaryPaymentStaff")
  salaryPaymentsRecorded     SalaryPayment[]            @relation("SalaryPaymentRecordedBy")
  leadsAssigned              Lead[]                     @relation("LeadAssignedTo")
  leadsRecorded              Lead[]                     @relation("LeadRecordedBy")
  attendanceEntries          AttendanceEntry[]          @relation("AttendanceStaff")
  attendanceEntriesRecorded  AttendanceEntry[]          @relation("AttendanceRecordedBy")
  fieldAssignments           FieldAssignment[]          @relation("FieldAssignmentStaff")
  fieldAssignmentsCreated    FieldAssignment[]          @relation("FieldAssignmentCreatedBy")
  treasuryDayClosuresClosed  TreasuryDayClosure[]       @relation("TreasuryDayClosureClosedBy")
  treasuryDayClosuresReopened TreasuryDayClosure[]       @relation("TreasuryDayClosureReopenedBy")
  orderTemplatesCreated      OrderTemplate[]
  orderItemProductionUpdates OrderItem[]                @relation("OrderItemProductionUpdatedBy")
  orderItemReturnsRecorded   OrderItemReturn[]

  @@unique([email], where: { isDeleted: false })
  @@index([isDeleted])
  @@index([branchId])
  @@index([departmentId])
  @@index([isActive])
}

/// A role is a named, DB-editable bundle of permissions. `isSystem` protects
/// the 8 seeded default roles from deletion (they can still be renamed or
/// have their permission set adjusted through the Role management UI).
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // e.g. "SUPER_ADMIN", stable, machine-referenced
  label       String // display name, editable, e.g. "Super Admin"
  description String?
  isSystem    Boolean @default(false)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@index([isDeleted])
}

/// The permission catalog. `key` is what `requirePermission()` middleware
/// checks against; `module` is `key`'s prefix, stored redundantly for fast
/// grouped-by-module queries in the Permissions management UI. `isSystem`
/// protects permissions actual code depends on from being deleted via the
/// management UI (deleting one out from under a live `requirePermission()`
/// check would silently lock everyone out of that action).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique // e.g. "customers.view", "orders.*", "*"
  module      String // e.g. "customers" ("*" for the global wildcard)
  label       String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@index([module])
}

model UserRole {
  id         String       @id @default(uuid()) @db.Uuid
  staffId    String       @db.Uuid
  staff      StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  roleId     String       @db.Uuid
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@unique([staffId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

/// Explicit branch-access grant beyond a user's home branch (`StaffProfile.
/// branchId`) — e.g. a regional manager who needs to see two branches.
/// Users with the SUPER_ADMIN role bypass this table entirely (see
/// `canAccessBranch()` in `src/lib/permissions.ts`) rather than needing a
/// row per branch.
model UserBranchAccess {
  id        String       @id @default(uuid()) @db.Uuid
  staffId   String       @db.Uuid
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branchId  String       @db.Uuid
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  grantedAt DateTime     @default(now())

  @@unique([staffId, branchId])
}

// ---------------------------------------------------------------------------
// Business Partners (FEATURE-002). Replaces the previously separate
// Customer/Supplier placeholders — see
// docs/AI/FEATURES/FEATURE-002-CUSTOMERS/01_ANALYSIS.md (Approved: Business
// Partner + Contact Person). A partner may hold multiple roles (Customer,
// Supplier, ...) at once instead of needing a separate record per role.
// Shared across branches; branchId is the partner's primary/home branch,
// not a visibility restriction — any staff with `partners.view` may see any
// partner regardless of branch.
//
// See docs/AI/FEATURES/FEATURE-002-CUSTOMERS/03_IMPLEMENT.md. Contacts
// (M2), addresses (M3), and categories/tags (M4) are modeled; credit, tax,
// documents, notes, duplicate detection, and merge are later milestones
// and intentionally not modeled here yet.
// ---------------------------------------------------------------------------

model BusinessPartner {
  id           String  @id @default(uuid()) @db.Uuid
  nameAr       String
  nameEn       String?
  shortName    String?
  isIndividual Boolean @default(false)
  // Owner, 2026-08-13: "عايزة يفرق بين الشركة والفرد... اكتب إسم فرد أو
  // سيدة" — only meaningful when isIndividual is true; picks "السيد"/
  // "السيدة" over the company-style "السادة" on printed documents.
  gender       Gender?

  roles  PartnerRole[]
  status PartnerStatus @default(PROSPECT)

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  salesRepId String?       @db.Uuid
  salesRep   StaffProfile? @relation(fields: [salesRepId], references: [id])

  phone String?
  email String?
  notes String?

  /// PRODUCT_ROADMAP.md §2 — where this lead/customer came from. Set once
  /// at creation typically, editable any time from the Overview tab.
  leadSource LeadSource?
  /// Updated automatically whenever a new PartnerNote is added to this
  /// partner (see partnerNotes.ts's createPartnerNote), and editable by
  /// hand from the Overview tab too — the roadmap's "يدوي أو تلقائي" both
  /// write the same column, there is no second "manual" field.
  lastContactedAt DateTime?
  /// Optional reminder date — purely informational today (no notification
  /// engine exists yet per CLAUDE.md §10), surfaced on the Overview tab so
  /// staff can see it at a glance without a dedicated task list.
  nextFollowUpAt DateTime?

  // FEATURE-002 M4. Zero-or-one Category (a plain nullable FK — no
  // exclusivity/lock pattern needed, unlike ContactPerson.isPrimary or
  // PartnerAddress.isDefault, since there is only ever one FK column to
  // update, not a flag to move between sibling rows). Zero-or-more Tags
  // via the BusinessPartnerTag join table.
  categoryId String?              @db.Uuid
  category   PartnerCategory?     @relation(fields: [categoryId], references: [id])
  tags       BusinessPartnerTag[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts               ContactPerson[]
  addresses              PartnerAddress[]
  // FEATURE-002 M5. Named `partnerNotes`, not `notes` — the scalar `notes`
  // field above (M1, a single free-text remarks field edited from the
  // Overview tab) already owns that name. `PartnerNote` is a distinct,
  // unlimited, first-class, pinnable, audited entity; the two are not the
  // same concept and are not merged.
  partnerNotes           PartnerNote[]
  // FEATURE-002 M6. Optional 1:1 — see PartnerCommercialProfile's own doc
  // comment for why this is a separate model, not inline fields here.
  commercialProfile      PartnerCommercialProfile?
  orders                 Order[]
  quotations             Quotation[]
  treasuryEntries        TreasuryEntry[]
  tenders                Tender[]
  attachments            Attachment[]
  supplierPurchases      SupplierPurchase[]
  supplierPayments       SupplierPayment[]
  // FEATURE-004 M1 — a partner holding the SUPPLIER role may be assigned to
  // an EXTERNAL WorkflowStage's StageInstance (VISION.md's External
  // Supplier Workflow), reusing BusinessPartner rather than a parallel
  // Supplier model, per Reuse Before Create (see SupplierPurchase/
  // SupplierPayment's own identical reuse).
  assignedStageInstances StageInstance[]
  // See AuditLog.partnerId's doc comment for why this denormalized
  // back-relation exists (Timeline Preparation / Activity Feed Ready).
  auditLogs              AuditLog[]
  orderTemplates         OrderTemplate[]

  @@index([isDeleted])
  @@index([status])
  @@index([branchId])
  @@index([nameAr])
  @@index([categoryId])
  /// Reverse of `Lead.convertedPartnerId` — set only when this partner originated from a converted Lead.
  convertedFromLead Lead?
}

/// PRODUCT_ROADMAP.md §2 ("المرحلة الثانية") — a Lead is a separate,
/// lighter-weight entity from BusinessPartner (owner's own framing:
/// "Lead ككيان منفصل عن العميل"), not a BusinessPartner row with a
/// PROSPECT status — a prospect that never converts shouldn't clutter the
/// real customer list/reports. Converting (`POST /:id/convert`) creates a
/// real BusinessPartner from this same data ("بدون إعادة إدخال" — no
/// re-typing), sets `convertedPartnerId`, and stage → CONVERTED; both are
/// permanent, a converted or rejected Lead is never reopened.
model Lead {
  id String @id @default(uuid()) @db.Uuid

  name  String
  phone String
  email String?

  source LeadSource?
  stage  LeadStage   @default(NEW)
  notes  String?

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  assignedToId String?       @db.Uuid
  assignedTo   StaffProfile? @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  recordedById String       @db.Uuid
  recordedBy   StaffProfile @relation("LeadRecordedBy", fields: [recordedById], references: [id])

  /// Optional reminder date — same purely-informational field BusinessPartner.nextFollowUpAt already is (no notification engine yet, CLAUDE.md §10).
  nextFollowUpAt DateTime?

  /// Set only once, by `convertLead` — the real customer record this Lead became.
  convertedPartnerId String?          @unique @db.Uuid
  convertedPartner   BusinessPartner? @relation(fields: [convertedPartnerId], references: [id], onDelete: SetNull)
  /// Set only when `stage: REJECTED` — why this lead didn't convert.
  rejectedReason String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([stage])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Categories & Tags (FEATURE-002 M4). Both are administrator-managed
// catalogs (mutated only via `settings.edit`, mirroring SheetType/
// SizeFamily), distinct from PartnerRole (what capacity a partner acts
// in, fixed enum, set at data-model design time) and PartnerStatus
// (lifecycle stage) — Category/Tag are open-ended, business-configurable
// segmentation, per 00_REQUIREMENTS.md §14-15.
//
// Category is a plain nullable FK on BusinessPartner (zero-or-one, no
// exclusivity pattern needed). Tag is many-to-many via the explicit
// BusinessPartnerTag join table (Prisma requires an explicit join model
// once the relation carries its own metadata/needs cascade behavior
// tuned per side; kept explicit here for the same reason M2/M3 favored
// explicitness over implicit magic).
// ---------------------------------------------------------------------------

model PartnerCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partners BusinessPartner[]

  @@index([isDeleted])
  @@index([isActive])
}

model PartnerTag {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partnerTags BusinessPartnerTag[]

  @@index([isDeleted])
  @@index([isActive])
}

/// Owner (2026-08-17, "عايز في الإعدادات أقدر أضيف على الخدمات الإضافية
/// خدمة... مفيهاش تكسير ولزق، ومفيهاش فورمة تكسير") — the "الخدمات
/// الإضافية" checklist on the order composer (bagging/adhesive/sample and
/// whatever the owner adds) was hardcoded; this makes it an admin-managed
/// catalog instead (rule 15), same shape/pattern as `PartnerTag` above.
/// `sortOrder` controls display order in the composer's checklist —
/// options aren't alphabetized, they're grouped by how an operator
/// actually scans them.
model ExtraServiceOption {
  id        String  @id @default(uuid()) @db.Uuid
  label     String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  /// Owner ("عايز الخدمات الإضافية دي على حسب القسم... انا اللي احدد ده من
  /// الإعدادات") — which production tracks this option applies to. Empty
  /// array (the default, and every pre-existing row's value after the
  /// backfill-free migration) means "no restriction — show for every
  /// track", exactly matching today's actual behavior; the owner opts an
  /// option INTO specific tracks by picking one or more, never has to
  /// touch options they don't care about.
  applicableTracks ProductionTrack[] @default([])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([isActive])
}

/// Owner (2026-08-20) — "شرائح كمية أعدلها بنفسي من الإعدادات": a fully
/// admin-managed quantity-tiered price list, one independent table per
/// (basis, colorMode, sides) combination (12 in total — QUARTER/A4_DIRECT/
/// A3_DIRECT × COLOR/BW × SINGLE/DOUBLE), replacing the old single flat
/// `Setting.digitalPrintPricePerQuarter` constant (column kept per rule 2 —
/// no deletion without an explicit ask — but no longer read by the pricing
/// engine). `minQuantity` is the tier's lower bound (inclusive); the
/// engine picks the highest tier whose `minQuantity` is still ≤ the item's
/// quantity, so tiers don't need an explicit upper bound each — adding a
/// new tier above the current highest just extends the table.
model DigitalPriceTier {
  id           String            @id @default(uuid()) @db.Uuid
  basis        DigitalPrintBasis
  colorMode    DigitalColorMode
  sides        DigitalSides
  minQuantity  Int
  pricePerUnit Decimal           @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([basis, colorMode, sides, minQuantity])
  @@index([basis, colorMode, sides])
}

/// Join table: which Tags are currently assigned to which BusinessPartner.
/// Plain rows with no independent lifecycle of their own (ADR 0007) — a
/// tag assignment is created/removed outright, never soft-deleted, exactly
/// like OrderItem/QuotationItem.
model BusinessPartnerTag {
  partnerId String          @db.Uuid
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tagId     String          @db.Uuid
  tag       PartnerTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([partnerId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Contact Persons (FEATURE-002 M2). First-class per the Approved decision
// in 01_ANALYSIS.md — a named individual who represents a BusinessPartner,
// with their own authority flags. Every ContactPerson belongs to exactly
// one BusinessPartner (no shared/cross-partner contacts in this milestone).
//
// isPrimary is intentionally NOT settable through the general update path
// — see the Set Primary business rule enforced in the service/controller
// layer, which unsets any other primary contact for the same partner in
// the same transaction, inside a row lock on the parent BusinessPartner
// (see setPrimaryContactPerson) to stay correct under concurrent
// requests. isActive is a separate concept from isDeleted: isActive is a
// business toggle (an inactive contact can be reactivated, and cannot be
// primary while inactive); isDeleted is the standard soft-delete
// lifecycle (ADR 0007) — same split as StaffProfile.
//
// The "only one Primary Contact per partner" rule is enforced twice,
// deliberately: the application layer (above) gives a clean error
// message and stays race-free under normal concurrent use via the row
// lock; the partial unique index below (`partialIndexes` preview
// feature, confirmed working via `prisma migrate diff` before adopting
// it) is the non-negotiable database-level guarantee that survives any
// future bug or direct-database access — this can never silently hold
// two primary contacts for the same partner, even if the application
// logic above is ever bypassed or changed incorrectly.
// ---------------------------------------------------------------------------

model ContactPerson {
  id        String          @id @default(uuid()) @db.Uuid
  partnerId String          @db.Uuid
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  fullName   String
  jobTitle   String?
  department String?

  mobile   String?
  phone    String?
  whatsapp String?
  email    String?

  preferredContactMethod PreferredContactMethod?

  isPrimary Boolean @default(false)

  canApproveQuotations         Boolean @default(false)
  canApproveWorkOrders         Boolean @default(false)
  canApproveFinancialDocuments Boolean @default(false)

  notes    String?
  isActive Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId], where: { isPrimary: true, isDeleted: false })
  @@index([partnerId])
  @@index([isDeleted])
  @@index([isPrimary])
}

// ---------------------------------------------------------------------------
// Addresses (FEATURE-002 M3). Every field is optional except `name` and
// `type`, since address formats vary too much by country to require a
// fixed shape. Coordinates are Float, not Decimal — the "money fields use
// Decimal" convention above is about currency precision, not geographic
// coordinates.
//
// "Only one default address per Address Type" mirrors ContactPerson's
// "only one Primary Contact" pattern exactly, and for the same two
// reasons: a row lock on the parent BusinessPartner in the
// set-default-address service call for concurrency safety, plus a
// database-level partial unique index — scoped to (partnerId, type),
// since a partner may have one default BILLING address AND one default
// SHIPPING address at the same time, just not two default BILLING
// addresses.
// ---------------------------------------------------------------------------

model PartnerAddress {
  id        String          @id @default(uuid()) @db.Uuid
  partnerId String          @db.Uuid
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  name String
  type AddressType

  country     String?
  governorate String?
  city        String?
  district    String?
  street      String?
  building    String?
  floor       String?
  apartment   String?
  postalCode  String?

  googleMapsUrl String?
  latitude      Float?
  longitude     Float?

  notes String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, type], where: { isDefault: true, isDeleted: false })
  @@index([partnerId])
  @@index([isDeleted])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Notes (FEATURE-002 M5). Unlimited, first-class, timestamped,
// attributable free-text entries per partner — distinct from
// `BusinessPartner.notes` above (a single M1 scalar remarks field; not
// merged with this model, not renamed, not redesigned).
//
// `createdBy`/`updatedBy` are bare UUIDs, not formal relations to
// StaffProfile — same deliberate simplification ADR 0007 already applies
// to `deletedBy`, to avoid duplicate named relations on StaffProfile.
// The API resolves author names by cross-referencing the existing
// `GET /api/users` list client-side rather than adding a new relation.
//
// `isPinned` is intentionally NOT an "exactly one" exclusivity flag —
// unlike ContactPerson.isPrimary/PartnerAddress.isDefault, many notes may
// be pinned simultaneously ("pinned notes always appear first, then
// newest first" describes a two-tier sort, not single-item exclusivity).
// No lock/transaction pattern or partial unique index applies here.
// ---------------------------------------------------------------------------

model PartnerNote {
  id        String          @id @default(uuid()) @db.Uuid
  partnerId String          @db.Uuid
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  title String
  body  String
  color String?

  isPinned Boolean @default(false)

  createdBy String  @db.Uuid
  updatedBy String? @db.Uuid

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
  @@index([isDeleted])
  @@index([isPinned])
}

// ---------------------------------------------------------------------------
// Commercial & Credit Profile (FEATURE-002 M6). Kept as its own model —
// never inline fields on BusinessPartner — per the service-boundary
// decision in 02_PLAN.md §3: credit decisions follow a different approval
// chain (Accounts/Credit Control) than partner identity (Sales/Customer
// Service), so the two must not share one service or one set of
// permissions. Also the concrete implementation of the pre-M6
// "Commercial Profile Separation" and "Avoid God Objects" rules.
//
// One-to-zero-or-one with BusinessPartner (`partnerId @unique`) — a
// partner may have no commercial profile yet (e.g. a fresh PROSPECT).
//
// Deliberately excluded from this milestone:
//   - Tax Information — already has its own dedicated future milestone
//     (M7 Tax & Compliance Information per 03_IMPLEMENT.md's roadmap);
//     adding it here would duplicate that milestone's planned scope.
//   - Sales Representative — already exists as `BusinessPartner.salesRepId`
//     (M1, core identity). Not duplicated here.
//   - Commercial Classification — implemented as `priceTier` below, a
//     free-text field distinct from the M4 `PartnerCategory` (VIP/Gold/
//     Silver/...): Category is general partner segmentation used across
//     the whole partner record; priceTier is commercial/pricing-specific
//     and scoped to this profile only.
//
// No soft-delete triad — a deliberate exception to ADR 0007's general
// convention (see that ADR's Consequences section): this is a 1:1 detail
// record of BusinessPartner, not an independently-addressable list-of-many
// entity the way ContactPerson/PartnerAddress/PartnerNote are. The
// correct soft-delete unit is the BusinessPartner itself — deleting the
// partner already makes its commercial profile inaccessible (access is
// always partner-scoped, checked via the partner's own isDeleted first).
// `onDelete: Cascade` handles the (never-exercised-by-the-app, since
// partners are always soft-deleted) hard-delete case at the DB level.
// ---------------------------------------------------------------------------

/// Credit/account standing — distinct from BusinessPartner.status (overall
/// partner lifecycle: Prospect/Active/Inactive/Blocked). This is narrower:
/// whether the partner's account is currently in good standing for
/// commercial transactions.
enum PartnerCommercialStatus {
  ACTIVE
  ON_HOLD
  UNDER_REVIEW
}

enum PartnerRiskLevel {
  LOW
  MEDIUM
  HIGH
}

model PartnerCommercialProfile {
  id        String          @id @default(uuid()) @db.Uuid
  partnerId String          @unique @db.Uuid
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  creditLimit            Decimal?                @db.Decimal(12, 2)
  /// Net payment terms, in days (e.g. 30 for "Net 30"). A single number,
  /// not a richer terms model — nothing more specific was ever specified.
  paymentTermsDays       Int?
  preferredPaymentMethod PaymentMethod?
  /// Free text, not an enum — no fixed set of tier names was specified;
  /// see the model-level comment above for why this is distinct from
  /// PartnerCategory.
  priceTier              String?
  status                 PartnerCommercialStatus @default(ACTIVE)
  riskLevel              PartnerRiskLevel?
  /// Not yet enforced or used in any calculation anywhere in the system —
  /// captured now, ahead of any real multi-currency support, per the
  /// explicit "future-ready" requirement. A loose string (e.g. "EGP"),
  /// not a Currency table/enum — that infrastructure does not exist yet
  /// and inventing it now would be premature.
  preferredCurrency      String?
  /// Distinct from BusinessPartner.notes (M1, one general remark) and
  /// PartnerNote (M5, unlimited pinnable/searchable notes) — this is a
  /// short, commercial-specific annotation visible only to
  /// partners.credit.manage holders, not the general Notes feature.
  internalNotes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Owner (2026-08-17, "بعد ما الاوردر يتحفظ يسألني هل احفظه كقالب دوري")
/// — a reusable snapshot of an order's line-item configuration, offered
/// right after an order is saved. `itemsSnapshot` stores the same
/// pricing-input shape `NewOrderPage.tsx` already builds per line (the
/// `OrderItemPricingInput` config), reused verbatim to repopulate the
/// composer — no separate/duplicated item-shape logic (rule 5). Deliberately
/// NOT bound to a specific customer (`partnerId` optional) — a template is
/// "this exact order configuration," reusable for any customer who wants
/// the same recurring job, not just the one who first ordered it.
model OrderTemplate {
  id String @id @default(uuid()) @db.Uuid

  name String

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById String       @db.Uuid
  createdBy   StaffProfile @relation(fields: [createdById], references: [id])

  /// The customer this template was first saved from — optional context only,
  /// never restricts which customer it may be reused for.
  partnerId String?          @db.Uuid
  partner   BusinessPartner? @relation(fields: [partnerId], references: [id])

  itemsSnapshot Json

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([partnerId])
  @@index([isDeleted])
}

// ---------------------------------------------------------------------------
// Orders & Invoices (schema only — API/UI in Phase 6).
// Order rows double as invoices in this system, exactly as in legacy.
// ---------------------------------------------------------------------------

model Order {
  id            String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique // e.g. CLP-INV-2026-000001, see DocumentSequence

  branchId  String          @db.Uuid
  branch    Branch          @relation(fields: [branchId], references: [id])
  /// Owner (2026-08-20, "فاتورة بدون إسم العميل") — nullable for walk-in/cash
  /// sales (INVENTORY_RETAIL, MANUAL line items) that don't need a
  /// `BusinessPartner` record at all. Application-level rule (not enforced
  /// at the DB level): required unless every item on the order is one of
  /// those two kinds — see `orderService.ts`'s `createOrder`.
  partnerId String?         @db.Uuid
  partner   BusinessPartner? @relation(fields: [partnerId], references: [id])
  staffId   String          @db.Uuid
  staff     StaffProfile    @relation(fields: [staffId], references: [id])

  date            DateTime    @default(now())
  subtotal        Decimal     @db.Decimal(12, 2)
  discountPercent Decimal     @default(0) @db.Decimal(6, 3)
  vatOn           Boolean     @default(false)
  vatAmount       Decimal     @default(0) @db.Decimal(12, 2)
  finalTotal      Decimal     @db.Decimal(12, 2)
  paymentTerms    String?
  deliveryDate    DateTime?
  customerNotes   String?
  internalNotes   String?
  status          OrderStatus @default(DRAFT)

  // FEATURE-006 — Document Templates & Printing. `documentOverrides` is
  // this document's one-time presentation customization (never written
  // back to Setting or to documentTemplate); `documentSnapshot` is the
  // fully resolved, frozen render configuration captured once at first
  // print — never silently recomputed afterward, per the explicit
  // hierarchy in FEATURE-006's 00_REQUIREMENTS.md.
  documentTemplateId String?           @db.Uuid
  documentTemplate   DocumentTemplate? @relation(fields: [documentTemplateId], references: [id])
  documentOverrides  Json?
  documentSnapshot   Json?

  items           OrderItem[]
  itemGroups      OrderItemGroup[]
  payments        Payment[]
  /// FEATURE-016+ (2026-08-16, "أمر شغل مستقل لكل صنف حسب مساره") — was a
  /// singular `WorkOrder?` (one order = one order-level production track).
  /// Now plural: one Work Order per distinct `ProductionTrack` actually
  /// present among this order's items (see `OrderItem.productionTrack`/
  /// `workOrderId`) — a mixed-kind order (e.g. an Offset flyer + a
  /// Sublimation mug) gets two independent Work Orders, each tracking only
  /// its own items through its own workflow.
  workOrders      WorkOrder[]
  treasuryEntries TreasuryEntry[]
  attachments     Attachment[]
  quotationOrigin Quotation?      @relation("QuotationConversion")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([partnerId])
  @@index([branchId])
  @@index([status])
}

/// Full denormalized calculator output snapshot (`breakdown`), preserving the
/// legacy denormalized-snapshot behavior (LEGACY_ANALYSIS §8) — a historical
/// line item never changes even if the underlying paper/price catalog does.
model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String // loose | notebook | envelope | folders | boards | product | service
  modelName String?
  breakdown Json

  /// FEATURE-007 PE-E — the frozen pricing-engine result for this item
  /// (packages/shared/src/pricing/*'s `.total`). Kept as its own queryable/
  /// summable column alongside `breakdown` (which holds the full
  /// computation detail) so `Order.subtotal` can be derived by summing
  /// this column without parsing JSON.
  itemTotal Decimal? @db.Decimal(12, 2)

  /// FEATURE-007 M2 — sheet-count-to-inventory link. All nullable/additive:
  /// only populated when `kind` is 'loose' or 'notebook' AND the caller
  /// supplied a size/family/stock item (paper-consuming items only —
  /// product/service items never touch inventory). `sheetsConsumed` is
  /// frozen at creation time (never recomputed), matching this project's
  /// "freeze by default" discipline — it is history of what was deducted,
  /// not a live-recalculated figure.
  sizeFamilyKey   String?
  realSizeLabel   String?
  inventoryItemId String?        @db.Uuid
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  sheetsConsumed  Decimal?       @db.Decimal(14, 3)

  /// "أمر شغل مستقل لكل صنف حسب مساره" (2026-08-16) — frozen at creation
  /// from the composer tab the item was built under (see
  /// `packages/shared/src/orders/itemCategories.ts`'s `productionTrack` on
  /// each tab). Null = this item never enters production at all
  /// (`INVENTORY_RETAIL` items, or a track with no published
  /// WorkflowTemplate yet — `READY_PRODUCTS` today).
  productionTrack ProductionTrack?
  /// Set once this item's Work Order is created (same request, same
  /// transaction as pricing/stock — see `orderService.ts`'s
  /// `tryAutoCreateWorkOrders`). Stays null for items with no
  /// `productionTrack`, or whose track had no published template at save
  /// time (the order still saves — best-effort, never blocks).
  workOrderId String?    @db.Uuid
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  /// Multi-material pricing (2026-08-17) — NOTEBOOK/DIGITAL items only.
  /// When populated, this is the sole source of truth for stock linkage on
  /// this item (`inventoryItemId`/`sheetsConsumed` above stay null for
  /// these two kinds). Every other kind keeps using the single
  /// `inventoryItemId`/`sheetsConsumed` columns above, untouched.
  materials OrderItemMaterial[]

  /// "تصميم واحد بمتغيرات إنتاج متعددة" (2026-08-19) — optional link to the
  /// other OrderItems this one shares a design/artwork with (e.g. 2×A4 +
  /// 50×A5 of the same flyer). Purely a sales/display/entry concern — has
  /// no effect on pricing (still computed per item, independently, exactly
  /// as before) or on which WorkOrder this item lands in (still grouped by
  /// `productionTrack` alone, unchanged).
  groupId String?         @db.Uuid
  group   OrderItemGroup? @relation(fields: [groupId], references: [id])

  /// Per-variant production progress (2026-08-19) — independent of the
  /// shared WorkOrder/WorkflowInstance's own stage-by-stage progress.
  /// `requiredQuantity` is a frozen snapshot of this item's own quantity,
  /// read once from the validated pricing input at creation time (never
  /// recomputed — same "freeze by default" discipline as `sheetsConsumed`);
  /// null for kinds with no single meaningful quantity. `producedQuantity`/
  /// `productionStatus` are staff-updated as pieces are physically
  /// finished, independent of any other item sharing this WorkOrder.
  requiredQuantity Int?
  producedQuantity Int                        @default(0)
  productionStatus OrderItemProductionStatus  @default(WAITING)

  productionUpdatedAt   DateTime?
  productionUpdatedById String?       @db.Uuid
  productionUpdatedBy   StaffProfile? @relation("OrderItemProductionUpdatedBy", fields: [productionUpdatedById], references: [id])

  /// Owner (2026-08-23, "مرتجعات: بضاعة من المخزون فقط") — only ever
  /// populated for `breakdown.kind === 'INVENTORY_RETAIL'` items.
  returns OrderItemReturn[]

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
  @@index([workOrderId])
  @@index([orderId, productionTrack])
  @@index([groupId])
}

/// Owner (2026-08-23, "مرتجعات" — عمل مرتجع لبضاعة جاهزة بيعت غلط، رجّع
/// الصنف الخطأ للمخزون). Deliberately scoped to `INVENTORY_RETAIL` items
/// only (the confirmed v1 scope — offset/digital production items aren't
/// returnable this way). Partial-quantity returns are supported: a single
/// `OrderItem` can have several `OrderItemReturn` rows, capped in the
/// service layer at `sheetsConsumed` (the quantity originally sold).
/// Never mutates `Order.finalTotal`/`OrderItem.itemTotal` (rule 9 — history
/// stays frozen); `returnedTotal`/`netTotal` are computed at read time from
/// these rows, same discipline as `paidTotal`/`remainingBalance`.
model OrderItemReturn {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  quantity     Decimal @db.Decimal(14, 3)
  refundAmount Decimal @db.Decimal(12, 2)
  reason       String?

  /// Owner (2026-08-20 decision, reused here 2026-08-23, "كاش في الدرج
  /// دائمًا") — the refund is always paid out as cash, regardless of how
  /// the original invoice was paid. See the paired `TreasuryEntry`.
  treasuryEntry TreasuryEntry?

  recordedById String       @db.Uuid
  recordedBy   StaffProfile @relation(fields: [recordedById], references: [id])
  branchId     String       @db.Uuid
  branch       Branch       @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([branchId])
}

/// "تصميم واحد بمتغيرات إنتاج متعددة" (2026-08-19, owner: "عايز أقدر أعمل
/// طلب فيه تصميم واحد بمقاسات/كميات مختلفة من غير ما أكرر كل حاجة") — a
/// lightweight link table, nothing more: groups `OrderItem`s that share the
/// same underlying design/artwork. No price field (the order's total stays
/// the sum of each item's own independent `itemTotal`, exactly as before),
/// no approval/status field (approval lives entirely in the Workflow Engine
/// — a real WorkflowStage + required WorkflowStageVariable — not
/// duplicated here). Purely additive; an `OrderItem` with `groupId: null`
/// behaves identically to today.
model OrderItemGroup {
  id      String  @id @default(uuid()) @db.Uuid
  orderId String  @db.Uuid
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label   String?

  items OrderItem[]

  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Multi-material pricing (2026-08-17) — the plural counterpart to
/// `OrderItem.inventoryItemId`/`sheetsConsumed` for NOTEBOOK (up to 3
/// materials: original/copy/second copy) and DIGITAL (arbitrary named
/// components: cover/interior/...) items. `role`/`paperName`/`sheetPrice`
/// are frozen at creation time — same "freeze by default" discipline as
/// `OrderItem.breakdown`.
model OrderItemMaterial {
  id          String    @id @default(uuid()) @db.Uuid
  orderItemId String    @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// NOTEBOOK: 'ORIGINAL' | 'COPY_1' | 'COPY_2' (fixed values written by the
  /// backend, not a DB enum). DIGITAL: the free-text component label the
  /// staff member typed ("الغلاف"/"الداخلي"/...).
  role      String
  sortOrder Int    @default(0)

  inventoryItemId String        @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  paperName       String
  sheetPrice      Decimal       @db.Decimal(12, 2)
  sheetsConsumed  Decimal       @db.Decimal(14, 3)

  createdAt DateTime @default(now())

  @@index([orderItemId])
  @@index([inventoryItemId])
}

model Payment {
  id      String        @id @default(uuid()) @db.Uuid
  orderId String        @db.Uuid
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method  PaymentMethod
  amount  Decimal       @db.Decimal(12, 2)

  treasuryEntry TreasuryEntry?

  /// Owner (2026-08-20, "تعديل/حذف مقيد بصلاحية خاصة") — a recorded
  /// payment was purely additive until now; edit/delete both go through
  /// the dedicated `payments.edit` permission (deliberately its own
  /// top-level module, not nested under `orders.*`, so the broad
  /// order-management grant most roles already hold does NOT
  /// automatically cover this). Soft-delete, same convention as every
  /// other sensitive delete (rule 19) — the linked TreasuryEntry is
  /// updated/soft-deleted in the same transaction, never one without the
  /// other, and a closed TreasuryDayClosure for the affected date reopens
  /// automatically so the correction is visible (rule 7).
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Quotations (FEATURE-003 M1 — Quotation Engine foundation; M2 — Order
// Conversion; the rest of this model was schema-only since Phase 1).
// Independent of Order per Requirement 2; conversion (M2,
// convertQuotationToOrder in quotationService.ts) creates a real Order,
// freezing the breakdown by default (ADR 0010) — the explicit
// `recalculate: true` re-run-current-pricing path remains deferred until
// a real Pricing Engine exists.
//
// Status transitions and approval-state transitions are service-layer-only
// (see apps/api/src/services/quotationService.ts) — no UI/route code
// decides legality of a transition, so this can move behind a real
// Workflow Engine later without an API-contract change (VISION.md's
// Workflow Engine Architecture).
// ---------------------------------------------------------------------------

/// Internal approval decision on a Quotation — deliberately independent of
/// QuotationStatus (the customer-facing document lifecycle). "Has this
/// been internally approved" and "has the customer accepted this" are
/// different questions with different actors; conflating them into one
/// enum would make both harder to query and reason about independently.
enum QuotationApprovalState {
  PENDING
  APPROVED
  NEEDS_REVISION
}

model Quotation {
  id              String @id @default(uuid()) @db.Uuid
  quotationNumber String @unique // e.g. CLP-QUO-2026-000001

  branchId  String          @db.Uuid
  branch    Branch          @relation(fields: [branchId], references: [id])
  /// Owner (2026-08-20, "فاتورة بدون إسم العميل") — see Order.partnerId's
  /// doc comment; same nullable walk-in/cash rule applies here.
  partnerId String?         @db.Uuid
  partner   BusinessPartner? @relation(fields: [partnerId], references: [id])
  staffId   String          @db.Uuid
  staff     StaffProfile    @relation(fields: [staffId], references: [id])

  date            DateTime        @default(now())
  /// FEATURE-007 (2026-08-12, owner: "التاريخ على عرض السعر يكون Optional") — not every quotation needs an expiry date.
  validUntil      DateTime?
  subtotal        Decimal         @db.Decimal(12, 2)
  discountPercent Decimal         @default(0) @db.Decimal(6, 3)
  vatOn           Boolean         @default(false)
  vatAmount       Decimal         @default(0) @db.Decimal(12, 2)
  finalTotal      Decimal         @db.Decimal(12, 2)
  status          QuotationStatus @default(DRAFT)

  // FEATURE-003 M1. Same naming convention Order already established
  // (Order.customerNotes/internalNotes, Phase 1) — customerNotes is
  // Customer-View-visible, internalNotes never is.
  customerNotes String?
  internalNotes String?

  approvalState QuotationApprovalState @default(PENDING)

  // FEATURE-003 M1 versioning: a new version is a new row, never an
  // overwrite. `previousVersionId` is @unique, so at most one row may
  // point back to a given earlier version — a linear chain, not a tree.
  // Full history is reconstructed by walking this chain, or (for
  // cross-entity activity) via AuditLog.partnerId.
  version           Int        @default(1)
  previousVersionId String?    @unique @db.Uuid
  previousVersion   Quotation? @relation("QuotationVersionChain", fields: [previousVersionId], references: [id])
  nextVersion       Quotation? @relation("QuotationVersionChain")

  convertedOrderId String? @unique @db.Uuid
  convertedOrder   Order?  @relation("QuotationConversion", fields: [convertedOrderId], references: [id])

  // FEATURE-006 — see the identical fields' doc comment on Order above.
  documentTemplateId String?           @db.Uuid
  documentTemplate   DocumentTemplate? @relation(fields: [documentTemplateId], references: [id])
  documentOverrides  Json?
  documentSnapshot   Json?

  items       QuotationItem[]
  itemGroups  QuotationItemGroup[]
  attachments Attachment[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  /// Owner (2026-08-17, "تتبع العدد بس، من غير منع") — tracked for
  /// visibility only, never enforced as a hard limit. Incremented by
  /// `recordQuotationPrint`, never touched anywhere else.
  printCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([partnerId])
  @@index([branchId])
  @@index([status])
  @@index([approvalState])
}

/// FEATURE-003 M1. `itemType` is the foundation-milestone discriminator —
/// a plain String (not a Prisma enum), matching OrderItem.kind's own
/// zero-migration extensibility: new business lines (Marketing Service,
/// Graphic Design, Photography, Video Editing, Branding, ...) introduce a
/// new itemType value, never a schema change. `kind`/`modelName`/
/// `breakdown` remain reserved for the future Pricing/Calculation Engine
/// (LEGACY_ANALYSIS §8) and are not populated by this milestone — all
/// three are nullable (kind/breakdown were NOT NULL under the old
/// schema-only definition; relaxed here since the table held zero rows in
/// any environment, and this milestone would otherwise have to write
/// meaningless placeholder data into them just to satisfy the constraint).
/// FEATURE-007 — wired to the same Pricing Engine as OrderItem (owner's
/// explicit clarification, 2026-08-10, that Quotation creation is not a
/// separate flow). `quantity`/`size` columns removed — the customer-facing
/// quantity now lives inside `breakdown` (same freeze pattern as
/// OrderItem, see order.ts's doc comment); no `inventoryItemId`/
/// `sheetsConsumed` here at all — Quotations never touch stock, only a
/// converted Order does.
model QuotationItem {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  itemType    String
  notes       String?
  description String?

  readyProductId String?       @db.Uuid
  readyProduct   ReadyProduct? @relation(fields: [readyProductId], references: [id])
  serviceId      String?       @db.Uuid
  service        Service?      @relation(fields: [serviceId], references: [id])

  kind      String?
  modelName String?
  breakdown Json?
  itemTotal Decimal? @db.Decimal(12, 2)

  sizeFamilyKey String?
  realSizeLabel String?

  /// "أمر شغل مستقل لكل صنف حسب مساره" (2026-08-16) — mirrors
  /// `OrderItem.productionTrack` (same freeze-at-creation discipline), so
  /// `convertQuotation` can carry each item's own track into the new
  /// Order's items instead of it being lost (a Quotation previously had no
  /// track concept at all, so work-order auto-creation on conversion was
  /// always a silent no-op).
  productionTrack ProductionTrack?

  /// "تصميم واحد بمتغيرات إنتاج متعددة" (2026-08-19) — mirrors
  /// `OrderItem.groupId`/`requiredQuantity` (same freeze/carry-through
  /// discipline `productionTrack` above already established): a Quotation
  /// built through the same composer as an Order can group items the same
  /// way, and `convertQuotation` carries the grouping + required quantity
  /// into new `OrderItemGroup`/`OrderItem` rows instead of losing them.
  groupId          String?              @db.Uuid
  group            QuotationItemGroup?  @relation(fields: [groupId], references: [id])
  requiredQuantity Int?

  createdAt DateTime @default(now())

  @@index([quotationId])
  @@index([readyProductId])
  @@index([serviceId])
  @@index([groupId])
}

/// "تصميم واحد بمتغيرات إنتاج متعددة" (2026-08-19) — the Quotation-side
/// mirror of `OrderItemGroup` (separate table since it hangs off a
/// different parent; same shape, same "link only, no price/approval
/// field" discipline). `convertQuotation` creates fresh `OrderItemGroup`
/// rows from these, it never reuses/reparents these rows onto an Order.
model QuotationItemGroup {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  label       String?

  items QuotationItem[]

  createdAt DateTime @default(now())

  @@index([quotationId])
}

// ---------------------------------------------------------------------------
// Work Orders (FEATURE-004 M1 — first real application code; schema existed
// since Phase 1). Independent of Order.status per Requirement 4 —
// production-floor lifecycle tracked separately, now via the Workflow
// Engine below rather than `productionStatus` (see its own deprecation
// comment) — WorkOrder itself stays the thin identity/numbering record.
// ---------------------------------------------------------------------------

model WorkOrder {
  id              String @id @default(uuid()) @db.Uuid
  workOrderNumber String @unique // e.g. CLP-WO-2026-000001

  /// "أمر شغل مستقل لكل صنف حسب مساره" (2026-08-16) — was `@unique`
  /// (exactly one Work Order per Order). Now a plain indexed FK: one Order
  /// can have multiple Work Orders, one per distinct `ProductionTrack`
  /// actually present among its items.
  orderId  String @db.Uuid
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  /// "أمر شغل مستقل لكل صنف حسب مساره" (2026-08-16) — frozen at creation.
  /// Which track this specific Work Order covers — drives
  /// `WorkOrderDocumentPage`'s template choice directly, with no need to
  /// re-derive it from the (now-removed) order-level track or from items.
  productionTrack ProductionTrack

  /// Reverse of `OrderItem.workOrderId` — only the items belonging to
  /// *this* Work Order, never the parent Order's full item list (that
  /// full-list confusion was the root of the mixed-track printing bug this
  /// whole change fixes — see `WorkOrderDocumentPage.tsx`).
  items OrderItem[]

  /// @deprecated FEATURE-004 M1. Superseded by `workflowInstance` — the
  /// Workflow Engine is the real source of truth for production state from
  /// this milestone forward. Kept (not removed) per explicit direction:
  /// zero code reads or writes this field going forward; removal is
  /// deferred to a future cleanup milestone once nothing could plausibly
  /// still depend on it. Never reference this field in new code.
  productionStatus WorkOrderProductionStatus @default(WAITING)

  workflowInstance WorkflowInstance?

  // FEATURE-006 — see the identical fields' doc comment on Order above.
  documentTemplateId String?           @db.Uuid
  documentTemplate   DocumentTemplate? @relation(fields: [documentTemplateId], references: [id])
  documentOverrides  Json?
  documentSnapshot   Json?

  attachments Attachment[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([branchId])
  @@index([productionStatus])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Workflow Engine (FEATURE-004 M1). Generic engine — see docs/AI/VISION.md's
// Workflow Engine Architecture / Dynamic Workflow Engine: the engine must
// never know what a Stamp or Offset Printing is, only execute templates.
// WorkOrder (above) is this milestone's first real consumer;
// WorkflowInstance's owner linkage follows Attachment's established
// multi-nullable-FK pattern (workOrderId today) so a future module (a
// Marketing Job, etc.) adds its own nullable column the same way, without
// the engine ever hardcoding "WorkOrder" as the only possible owner.
// ---------------------------------------------------------------------------

/// Admin-manageable list (VISION.md's Department-Based Workflow) — not a
/// hardcoded enum. Global, not branch-scoped: Department answers "what kind
/// of work," Branch answers "where" (FEATURE-004 01_ANALYSIS.md's Open
/// Decisions) — a StageInstance's branch is read from its owning business
/// record, never from a Department-Branch relationship. Not `isSystem`
/// like Role — no code ever branches on a specific department's identity.
model Department {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  code            String           @unique
  description     String?
  /// FEATURE-010 (2026-08-14) — groups a department under its production
  /// track for لوحة الإنتاج's "الأقسام" tab. Nullable: departments shared
  /// across every track (التصميم، التسليم) or unrelated to production
  /// (SALES, WAREHOUSE, PURCHASING, EXTERNAL_SUPPLIER, CUSTOMER_SERVICE)
  /// stay untagged on purpose — they don't belong to one track.
  productionTrack ProductionTrack?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff          StaffProfile[]
  userAccess     UserDepartmentAccess[]
  stages         WorkflowStage[]
  stageInstances StageInstance[]
  machines       Machine[]

  @@index([isDeleted])
}

/// Direct precedent: UserBranchAccess. StaffProfile.departmentId is the home
/// department; this table is additional access — the same "home + explicit
/// grants" shape, reused rather than reinvented.
model UserDepartmentAccess {
  id           String       @id @default(uuid()) @db.Uuid
  staffId      String       @db.Uuid
  staff        StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  departmentId String       @db.Uuid
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignedAt   DateTime     @default(now())

  @@unique([staffId, departmentId])
}

/// system_specifications_v2.md §6.5.1/§16.1 (2026-08-16, owner: "ابنيها
/// دلوقتي") — the "حالة كل ماكينة" piece of the Unified Production
/// Overview left out when that screen was first built. Deliberately scoped
/// to just a name/status/department — the full Capacity Rate/Scheduled-
/// vs-Actual-Hours alerting engine (§16.1's Smart Decision Engine) is a
/// separate, much larger feature, not part of "لوحة الإنتاج" itself.
enum MachineStatus {
  RUNNING
  STOPPED
  MAINTENANCE
}

model Machine {
  id   String @id @default(uuid()) @db.Uuid
  name String

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  /// Nullable like WorkflowStage.departmentId — a machine can exist before
  /// it's assigned to a specific department/track.
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  status MachineStatus @default(RUNNING)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([branchId])
  @@index([departmentId])
}

enum WorkflowStageType {
  INTERNAL
  EXTERNAL
}

enum WorkflowInstanceStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StageInstanceStatus {
  WAITING
  IN_PROGRESS
  DONE
  SKIPPED
  FAILED
}

/// Presets for a WorkflowStageVariable's answer type — structural (what
/// *kind* of value), never a business-line concept. `selectOptions` (the
/// actual choices for a SELECT variable) is data, not a schema concern.
enum WorkflowVariableDataType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  SELECT
}

/// Queue-ordering rank (FEATURE-004 Refinement 4) — a structural ranking,
/// not a rules engine; nothing in this milestone auto-assigns a priority.
enum WorkflowPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// FEATURE-004 Refinement 3 — the domain-event feed Timeline, Dashboard,
/// Notifications, AI, Reporting, and Analytics are meant to consume,
/// instead of inspecting workflow state directly. Distinct from AuditLog
/// (security/compliance "who did what") — both are written for the same
/// transition; neither replaces the other. See ADR-worthy reasoning in
/// FEATURE-004 01_ANALYSIS.md.
enum WorkflowEventType {
  INSTANCE_STARTED
  STAGE_STARTED
  STAGE_COMPLETED
  STAGE_SKIPPED
  STAGE_FAILED
  INSTANCE_COMPLETED
  INSTANCE_CANCELLED
}

/// A Workflow Template version (VISION.md's Workflow Templates / Workflow
/// Versioning). `code` is the stable identity shared across a template's
/// versions (e.g. `OFFSET_PRINTING`); `version`/`previousVersionId` is the
/// same non-destructive chain FEATURE-003 uses for Quotation versioning — a
/// new version is a new row, never an overwrite. `publishedAt` null = draft
/// (freely editable); once set, this version's stages are immutable
/// (FEATURE-004 02_PLAN.md's Business Rules) — further changes go through
/// `POST .../versions`, never a mutation of a published version. A running
/// WorkflowInstance's `templateId` points at one exact version forever;
/// publishing a new version never touches it.
model WorkflowTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  code        String
  name        String
  description String?

  version           Int               @default(1)
  previousVersionId String?           @unique @db.Uuid
  previousVersion   WorkflowTemplate? @relation("WorkflowTemplateVersionChain", fields: [previousVersionId], references: [id])
  nextVersion       WorkflowTemplate? @relation("WorkflowTemplateVersionChain")

  publishedAt DateTime?

  stages    WorkflowStage[]
  instances WorkflowInstance[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, version])
  @@index([isDeleted])
  @@index([code, publishedAt])
}

/// One stage within a WorkflowTemplate version — VISION.md's Workflow Stage
/// Configuration, in full. `nextStageId`/`failureStageId` are the routing
/// graph (FEATURE-004 00_REQUIREMENTS.md §7) — nullable self-references
/// within the same template version, deliberately NOT unique (a branching
/// or converging graph may have more than one stage point at the same next
/// stage). Immutable once its template is published.
model WorkflowStage {
  id         String           @id @default(uuid()) @db.Uuid
  templateId String           @db.Uuid
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  order     Int
  name      String
  stageType WorkflowStageType @default(INTERNAL)

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  defaultAssignedEmployeeId String? @db.Uuid

  estimatedDurationMinutes Int?
  requiresFiles            Boolean @default(false)
  requiresApproval         Boolean @default(false)
  requiresCostEntry        Boolean @default(false)
  requiresTimeTracking     Boolean @default(false)
  isMandatory              Boolean @default(true)
  canSkip                  Boolean @default(false)

  nextStageId String?         @db.Uuid
  nextStage   WorkflowStage?  @relation("WorkflowStageNext", fields: [nextStageId], references: [id])
  nextOfStage WorkflowStage[] @relation("WorkflowStageNext")

  failureStageId String?         @db.Uuid
  failureStage   WorkflowStage?  @relation("WorkflowStageFailure", fields: [failureStageId], references: [id])
  failureOfStage WorkflowStage[] @relation("WorkflowStageFailure")

  internalVisible Boolean @default(true)
  customerVisible Boolean @default(false)

  variables          WorkflowStageVariable[]
  stageInstances     StageInstance[]
  currentForInstance WorkflowInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([departmentId])
}

/// A stage's dynamic-field definitions (FEATURE-004 Refinement 2) — how a
/// Brass Plate's "Collect Customer Text" or an Acrylic Sign's size/options
/// gets captured without a hardcoded column per business line. Belongs to
/// the same immutable-once-published stage its parent WorkflowStage does —
/// no separate publish state of its own. The engine validates *presence* of
/// required variables before allowing a stage to advance; it never
/// interprets what a variable *means*.
model WorkflowStageVariable {
  id      String        @id @default(uuid()) @db.Uuid
  stageId String        @db.Uuid
  stage   WorkflowStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  key           String
  label         String
  dataType      WorkflowVariableDataType @default(TEXT)
  selectOptions Json?
  isRequired    Boolean                  @default(false)
  order         Int                      @default(0)

  createdAt DateTime @default(now())

  @@unique([stageId, key])
  @@index([stageId])
}

/// The running counterpart to a WorkflowTemplate version — one per business
/// record going through production. `templateId` is frozen at creation
/// (Workflow Versioning); `workOrderId` is nullable + unique (one instance
/// per work order this milestone) — see this model's own file-header note
/// on why the owner linkage isn't a generic ownerType/ownerId pair.
model WorkflowInstance {
  id         String           @id @default(uuid()) @db.Uuid
  templateId String           @db.Uuid
  template   WorkflowTemplate @relation(fields: [templateId], references: [id])

  workOrderId String?    @unique @db.Uuid
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])

  status WorkflowInstanceStatus @default(IN_PROGRESS)

  currentStageId String?        @db.Uuid
  currentStage   WorkflowStage? @relation(fields: [currentStageId], references: [id])

  stageInstances StageInstance[]
  events         WorkflowEvent[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([status])
  @@index([isDeleted])
}

/// One row per stage a WorkflowInstance passes through (FEATURE-004
/// 00_REQUIREMENTS.md §6). `departmentId` is denormalized from
/// `stage.departmentId` at creation — immutable, since the source stage is
/// immutable once published; queue lookups filter on this column directly
/// rather than joining through WorkflowStage on every query (the same
/// "snapshot for query performance" reasoning as OrderItem.breakdown).
/// External-stage fields are populated only when the stage is EXTERNAL —
/// unused otherwise, exactly like QuotationItem's unused fields per item
/// type. `priority`/`dueDate` are queue metadata (Refinement 4); delay is
/// deliberately NOT a stored column — computed at read time from `dueDate`
/// (see FEATURE-004 01_ANALYSIS.md's Queue Metadata reasoning).
model StageInstance {
  id                 String           @id @default(uuid()) @db.Uuid
  workflowInstanceId String           @db.Uuid
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  stageId            String           @db.Uuid
  stage              WorkflowStage    @relation(fields: [stageId], references: [id])

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  status             StageInstanceStatus @default(WAITING)
  assignedEmployeeId String?             @db.Uuid
  assignedEmployee   StaffProfile?       @relation(fields: [assignedEmployeeId], references: [id])

  startedAt                DateTime?
  finishedAt               DateTime?
  estimatedDurationMinutes Int?
  actualDurationMinutes    Int?

  waitingReason  String?
  blockingReason String?
  notes          String?

  priority WorkflowPriority @default(NORMAL)
  dueDate  DateTime?

  /// Answered values for this stage's WorkflowStageVariable definitions,
  /// keyed by `key`. Validated for required-variable presence in the
  /// routing function, not at the database level.
  variableValues Json?

  // External Supplier fields (VISION.md's External Supplier Workflow) —
  // populated only when stage.stageType is EXTERNAL. assignedSupplierId
  // reuses BusinessPartner (a SUPPLIER-role partner), not a parallel
  // Supplier model, per Reuse Before Create.
  assignedSupplierId String?          @db.Uuid
  assignedSupplier   BusinessPartner? @relation(fields: [assignedSupplierId], references: [id])
  sentDate           DateTime?
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?
  externalCost       Decimal?         @db.Decimal(12, 2)
  supplierStatus     String?

  attachments Attachment[]
  events      WorkflowEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowInstanceId])
  @@index([stageId])
  @@index([departmentId, status])
  @@index([assignedEmployeeId])
  @@index([assignedSupplierId])
}

/// The append-only domain-event feed (FEATURE-004 Refinement 3). No
/// UPDATE/DELETE path in this milestone's API — correcting history is
/// future work, not this one's. `payload` is a structured snapshot (not a
/// pointer to current state) so a consumer never has to join back to
/// mutable rows to make sense of an event after the fact.
model WorkflowEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  workflowInstanceId String           @db.Uuid
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  stageInstanceId    String?          @db.Uuid
  stageInstance      StageInstance?   @relation(fields: [stageInstanceId], references: [id])

  eventType WorkflowEventType
  payload   Json

  performedById String?       @db.Uuid
  performedBy   StaffProfile? @relation(fields: [performedById], references: [id])

  occurredAt DateTime @default(now())

  @@index([workflowInstanceId, occurredAt])
  @@index([stageInstanceId])
}

// ---------------------------------------------------------------------------
// Treasury. API/UI built in FEATURE-006 M3/M4; per-wallet `method`
// breakdown added in FEATURE-007 M3. Every field from Requirement 5 is a
// direct column, not a join.
// ---------------------------------------------------------------------------

model TreasuryEntry {
  id         String             @id @default(uuid()) @db.Uuid
  type       TreasuryType
  amount     Decimal            @db.Decimal(12, 2)
  category   String?
  note       String?
  date       DateTime
  sourceType TreasurySourceType @default(MANUAL)
  /// FEATURE-007 M3 — which wallet the money moved through (كاش/فودافون
  /// كاش/انستاباي/حساب بنكي), enabling the per-wallet balance breakdown the
  /// owner asked for. Nullable only for historical rows predating this
  /// column; the service layer requires it on every new entry (backfilled
  /// from `Payment.method` for existing `INVOICE_PAYMENT` rows).
  method     PaymentMethod?

  orderId   String?          @db.Uuid // = invoice id (Order doubles as invoice)
  order     Order?           @relation(fields: [orderId], references: [id])
  paymentId String?          @unique @db.Uuid
  payment   Payment?         @relation(fields: [paymentId], references: [id])
  partnerId String?          @db.Uuid
  partner   BusinessPartner? @relation(fields: [partnerId], references: [id])

  employeeAdvanceId          String?                   @unique @db.Uuid
  employeeAdvance            EmployeeAdvance?          @relation(fields: [employeeAdvanceId], references: [id])
  employeeAdvanceRepaymentId String?                   @unique @db.Uuid
  employeeAdvanceRepayment   EmployeeAdvanceRepayment? @relation(fields: [employeeAdvanceRepaymentId], references: [id])

  /// `sourceType: 'QUICK_SALE'` only — owner (2026-08-20, "بيخصم من المخزون
  /// ويتحط في الخزينه على طول"). Editing/deleting the StockMovement cascades
  /// to this entry (`inventoryService.updateStockMovement`/`deleteStockMovement`);
  /// this entry itself is never edited directly (see `sourceType !== 'MANUAL'`
  /// guard in `treasuryService.ts`).
  stockMovementId String?        @unique @db.Uuid
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  /// `sourceType: 'SALARY_PAYMENT'` only — see `SalaryPayment`'s own doc comment.
  salaryPaymentId String?        @unique @db.Uuid
  salaryPayment   SalaryPayment? @relation(fields: [salaryPaymentId], references: [id], onDelete: SetNull)

  /// `sourceType: 'RETURN'` only — see `OrderItemReturn`'s own doc comment.
  orderItemReturnId String?          @unique @db.Uuid
  orderItemReturn   OrderItemReturn? @relation(fields: [orderItemReturnId], references: [id], onDelete: SetNull)

  staffId  String       @db.Uuid // employee who recorded it (or who saved the source invoice)
  staff    StaffProfile @relation(fields: [staffId], references: [id])
  branchId String       @db.Uuid
  branch   Branch       @relation(fields: [branchId], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([branchId])
  @@index([type])
  @@index([date])
}

/// UX_PRODUCT_AUDIT.md § مشكلة 7.3 ("تصنيف مصروفات خزينة قابل للإدارة") —
/// an admin-managed canonical list for `TreasuryEntry.category`, so
/// reporting can group reliably instead of relying on free text. Mirrors
/// `PartnerTag`'s shape exactly (ADR 0007 soft-delete convention). Kept
/// deliberately independent of `TreasuryEntry.category`, which stays a
/// plain nullable string (no FK) — the entry form offers this list plus an
/// explicit "other" free-text fallback, so recording an entry never blocks
/// on the category catalog being complete, and existing free-text values
/// keep working unchanged.
model TreasuryCategory {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([isActive])
}

/// FEATURE-016, rebuilt 2026-08-18 (owner: "The goal is to have a proper
/// daily cash register closing system... Opening Balance + Total Inflows -
/// Total Outflows = Expected Closing Balance") — a real cash-drawer
/// reconciliation, not just a review marker anymore. Reconciliation is
/// CASH-method only (`method: 'CASH'` entries) since `actualCountedCash` is
/// physical cash counted by hand — Vodafone Cash/InstaPay/bank entries are
/// still tracked on `TreasuryEntry` as always, just outside this drawer
/// count. `openingBalance` carries forward from the most recent prior
/// closed (not reopened) day for the same branch; 0 if none exists yet.
/// One row per (branch, date) — `@@unique`; closing again while
/// `isOpen: false` is a 409 (`closeTreasuryDay`'s own doc comment).
/// `isOpen: true` means the day was reopened after closing (an authorized
/// correction) and new entries are allowed again until it is closed once
/// more — see `assertBranchDayNotClosed`/`reopenTreasuryDay`. Every
/// close/reopen is also written to `AuditLog` (STATUS_CHANGE), so the full
/// history survives even though this row only ever holds the latest state.
model TreasuryDayClosure {
  id       String   @id @default(uuid()) @db.Uuid
  branchId String   @db.Uuid
  branch   Branch   @relation(fields: [branchId], references: [id])
  date     DateTime @db.Date

  openingBalance         Decimal @db.Decimal(12, 2)
  totalInflows           Decimal @db.Decimal(12, 2)
  totalOutflows          Decimal @db.Decimal(12, 2)
  expectedClosingBalance Decimal @db.Decimal(12, 2)
  actualCountedCash      Decimal @db.Decimal(12, 2)
  difference             Decimal @db.Decimal(12, 2)
  entryCountAtClose      Int
  notes                  String?

  closedById String       @db.Uuid
  closedBy   StaffProfile @relation("TreasuryDayClosureClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime     @default(now())

  isOpen       Boolean       @default(false)
  reopenedById String?       @db.Uuid
  reopenedBy   StaffProfile? @relation("TreasuryDayClosureReopenedBy", fields: [reopenedById], references: [id])
  reopenedAt   DateTime?
  reopenReason String?

  @@unique([branchId, date])
  @@index([branchId])
}

// ---------------------------------------------------------------------------
// Employee Advances (FEATURE-008, 2026-08-13, owner: "هل هيطلعلي تقرير
// بالسلف بتاعت كل موظف ومتبقيله كام من المرتب"). Giving an advance is an
// atomic Payment+TreasuryEntry-style transaction (money actually leaves the
// drawer); a repayment either returns cash (same atomic pattern, INCOME) or
// is a salary deduction (recorded only — no payroll run exists in this
// system to pay out against). `remainingBalance` is always computed at read
// time (amount - sum(repayments.amount)), mirroring Order.remainingBalance,
// never stored.
// ---------------------------------------------------------------------------

model EmployeeAdvance {
  id String @id @default(uuid()) @db.Uuid

  staffId String       @db.Uuid
  staff   StaffProfile @relation("EmployeeAdvanceStaff", fields: [staffId], references: [id])

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  amount Decimal  @db.Decimal(12, 2)
  date   DateTime
  reason String?

  recordedById String       @db.Uuid
  recordedBy   StaffProfile @relation("EmployeeAdvanceRecordedBy", fields: [recordedById], references: [id])

  treasuryEntry TreasuryEntry?
  repayments    EmployeeAdvanceRepayment[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([branchId])
  @@index([isDeleted])
}

model EmployeeAdvanceRepayment {
  id String @id @default(uuid()) @db.Uuid

  advanceId String          @db.Uuid
  advance   EmployeeAdvance @relation(fields: [advanceId], references: [id])

  amount Decimal                @db.Decimal(12, 2)
  date   DateTime
  method AdvanceRepaymentMethod
  note   String?

  recordedById String       @db.Uuid
  recordedBy   StaffProfile @relation("EmployeeAdvanceRepaymentRecordedBy", fields: [recordedById], references: [id])

  treasuryEntry TreasuryEntry?

  createdAt DateTime @default(now())

  @@index([advanceId])
}

/// Owner (2026-08-20, "هل بيطلعلي عملية مباشرة آخر الاسبوع بمرتبات الناس
/// جاهزة تتخصم من الخزينة؟... لو لا طب هنعمل ده ازاي") — confirmed no
/// automatic run; a manual "صرف مرتب" button per employee instead. One row
/// per actual disbursement, created atomically with a `TreasuryEntry`
/// (EXPENSE), same pattern as `EmployeeAdvance` above. `periodStart`/
/// `periodEnd` are resolved server-side from `computeEmployeePayroll` at
/// payment time (never client-supplied) so they always reflect the real
/// pay period being settled. Deliberately does NOT auto-settle any
/// outstanding `EmployeeAdvance` rows — those still go through their own
/// explicit repayment flow; this only records that a salary amount was
/// physically paid out.
model SalaryPayment {
  id String @id @default(uuid()) @db.Uuid

  staffId String       @db.Uuid
  staff   StaffProfile @relation("SalaryPaymentStaff", fields: [staffId], references: [id])

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  note        String?

  recordedById String       @db.Uuid
  recordedBy   StaffProfile @relation("SalaryPaymentRecordedBy", fields: [recordedById], references: [id])

  treasuryEntry TreasuryEntry?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([branchId])
  @@index([isDeleted])
}

// ---------------------------------------------------------------------------
// Attendance (FEATURE-008, 2026-08-13, owner: "هل قسم الموظفين هيبقى مربوط
// بجهاز البصمة (لسه مجبتهوش) ولا في بديل"). A software check-in/check-out
// alternative until a fingerprint device is bought — one row per
// (staff, calendar day), self-service (any authenticated staff checks
// themself in/out) or admin-entered/corrected (employees.edit). Designed so
// a future device integration only needs to populate the same table (e.g.
// from an imported export), never a rewrite of this shape.
// ---------------------------------------------------------------------------

/// FEATURE-013 (2026-08-14) — how a check-in/check-out actually happened.
/// SELF_SERVICE is the original (and still default) behavior; KIOSK is the
/// shared-device+PIN flow for a multi-employee branch; GPS is a location-
/// confirmed check-in for staff sent to an external site before the office;
/// MANUAL is an admin correction (`upsertAttendanceEntry`, unchanged).
enum AttendanceSource {
  SELF_SERVICE
  KIOSK
  GPS
  MANUAL
}

model AttendanceEntry {
  id String @id @default(uuid()) @db.Uuid

  staffId String       @db.Uuid
  staff   StaffProfile @relation("AttendanceStaff", fields: [staffId], references: [id])

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  /// Calendar day this entry belongs to (midnight-anchored) — one row per (staffId, date).
  date       DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  note       String?

  /// FEATURE-013 — defaults to the original self-service behavior; every
  /// existing/future row is compatible with `employeePayrollService.ts`
  /// unchanged, since payroll only ever reads checkInAt/checkOutAt.
  source AttendanceSource @default(SELF_SERVICE)

  /// FEATURE-013 — populated only when `source = GPS` (the coordinates the
  /// employee's browser reported at the moment their field-assignment
  /// location was confirmed). Float, not Decimal — same convention as
  /// PartnerAddress.latitude/longitude (geographic precision, not currency).
  checkInLatitude  Float?
  checkInLongitude Float?

  recordedById String       @db.Uuid
  recordedBy   StaffProfile @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([staffId])
  @@index([branchId])
}

/// FEATURE-013 (2026-08-14, owner: "بيكون في حد انا مكلفه يروح مكان معين
/// قبل ما يجي") — a staff member assigned to visit a specific location
/// before coming to the office. The owner creates one of these (with a
/// target location picked on a map) for a given staff member and day;
/// the employee's own "تأكيد وصولي" action (see AttendanceEntry.source
/// GPS) confirms it by proximity and, on success, writes today's
/// AttendanceEntry — see `confirmFieldAssignmentLocation`.
enum FieldAssignmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model FieldAssignment {
  id String @id @default(uuid()) @db.Uuid

  staffId String       @db.Uuid
  staff   StaffProfile @relation("FieldAssignmentStaff", fields: [staffId], references: [id])

  branchId String @db.Uuid
  branch   Branch @relation(fields: [branchId], references: [id])

  /// Calendar day this assignment is for (midnight-anchored, same convention as AttendanceEntry.date).
  date DateTime

  locationLabel   String
  targetLatitude  Float
  targetLongitude Float
  /// Acceptable proximity radius for `confirmFieldAssignmentLocation` — a
  /// flat default (150m), not a configurable setting, same "flat constant"
  /// discipline as GRACE_MINUTES in employeePayrollService.ts.
  radiusMeters    Int    @default(150)

  status      FieldAssignmentStatus @default(PENDING)
  confirmedAt DateTime?

  createdById String       @db.Uuid
  createdBy   StaffProfile @relation("FieldAssignmentCreatedBy", fields: [createdById], references: [id])

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([branchId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Supplier purchases/payments (schema only — API/UI in Phase 11). The
// Supplier role is now just a PartnerRole on BusinessPartner (FEATURE-002),
// not a separate model — see the BusinessPartner section above.
// ---------------------------------------------------------------------------

model SupplierPurchase {
  id          String          @id @default(uuid()) @db.Uuid
  partnerId   String          @db.Uuid
  partner     BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  date        DateTime

  createdAt DateTime @default(now())
}

model SupplierPayment {
  id        String          @id @default(uuid()) @db.Uuid
  partnerId String          @db.Uuid
  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(12, 2)
  note      String?
  date      DateTime

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Tenders (schema only — API/UI in Phase 12). Shared across branches.
// ---------------------------------------------------------------------------

model Tender {
  id         String           @id @default(uuid()) @db.Uuid
  partnerId  String?          @db.Uuid
  partner    BusinessPartner? @relation(fields: [partnerId], references: [id])
  clientName String? // free-text fallback if not linked to a BusinessPartner record
  title      String
  value      Decimal          @db.Decimal(12, 2)
  deadline   DateTime?
  status     TenderStatus     @default(OPEN)
  notes      String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Inventory (Requirement 9). FEATURE-007 M2 is the first real application
// code against this — schema existed since Phase 1. PAPER-category items
// optionally link back to the existing pricing catalog (SheetType) so paper
// isn't defined twice; other categories (ink, plates, finishing,
// consumables) stand alone. `reorderLevel` is the low-stock threshold,
// configurable per item (never hardcoded) — surfaces in the "needs from
// supplier" list once `StockLevel.quantityOnHand <= reorderLevel`.
// ---------------------------------------------------------------------------

model InventoryItem {
  id           String           @id @default(uuid()) @db.Uuid
  category     MaterialCategory
  name         String
  unit         InventoryUnit
  sheetTypeId  String?          @unique @db.Uuid
  sheetType    SheetType?       @relation(fields: [sheetTypeId], references: [id])
  reorderLevel Decimal?         @db.Decimal(12, 3)
  /// system_specifications_v2.md §12.5 (2026-08-16) — supplier/manufacturer
  /// barcode, or an internal SKU-style code for items with none. Optional
  /// and unique (Postgres allows multiple NULLs under a unique index, so
  /// most items simply have none). Now read directly by POS scan-to-add
  /// (2026-08-16, second pass) for `READY_MADE` items.
  barcode      String?          @unique
  /// system_specifications_v2.md (2026-08-16) — retail price for a
  /// `READY_MADE` item sold directly from stock (owner: "مخزون جاهز عندي").
  /// Nullable — meaningless for the other 5 categories, whose cost feeds
  /// into a production pricing formula instead of a direct sale price.
  salePrice    Decimal?         @db.Decimal(12, 2)

  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  orderItems         OrderItem[]
  orderItemMaterials OrderItemMaterial[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([category])
}

/// Current on-hand quantity per item, per branch. Derivable from
/// StockMovement in principle; kept as a materialized value for fast reads
/// once inventory logic is actually implemented in a future phase.
model StockLevel {
  id              String        @id @default(uuid()) @db.Uuid
  inventoryItemId String        @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  branchId        String        @db.Uuid
  branch          Branch        @relation(fields: [branchId], references: [id])
  quantityOnHand  Decimal       @default(0) @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt

  @@unique([inventoryItemId, branchId])
}

/// In/out/adjustment ledger, deliberately mirroring TreasuryEntry's ledger
/// pattern (immutable log + derivable balance) for architectural consistency.
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  inventoryItemId String            @db.Uuid
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  branchId        String            @db.Uuid
  branch          Branch            @relation(fields: [branchId], references: [id])
  type            StockMovementType
  quantity        Decimal           @db.Decimal(14, 3)
  reference       String?
  date            DateTime          @default(now())

  /// Owner (2026-08-20, "بيخصم من المخزون ويتحط في الخزينه على طول") — set
  /// only for a quick-sale-originated movement (see `TreasuryEntry.stockMovementId`).
  treasuryEntry TreasuryEntry?

  /// Owner (2026-08-20, "لا عايز اقدر اعدل الحركة واحذفها") — this row was
  /// originally documented as an immutable ledger (matching TreasuryEntry),
  /// but the owner explicitly rejected the "record a correction entry
  /// instead" alternative and asked for real edit/delete. Soft-deleted
  /// (isDeleted/deletedAt/deletedBy — same columns as every other sensitive
  /// delete in this codebase, rule 19) rather than a hard delete, and both
  /// edit and delete are Audit Logged (rule 7) since they change a figure
  /// that has already fed `StockLevel.quantityOnHand`.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Attachments (Requirement 14) — schema only, no upload/storage wiring yet.
// "Invoices" and "Orders" are the same table in this system (Order), so the
// four relations below cover exactly the five document types requested.
// ---------------------------------------------------------------------------

model Attachment {
  id          String  @id @default(uuid()) @db.Uuid
  fileName    String
  fileType    String
  storagePath String? // reserved for a future Supabase Storage key
  sizeBytes   Int?
  /// Free string, not an enum — same zero-migration extensibility as
  /// QuotationItem.itemType/OrderItem.kind. Suggested values (not
  /// enforced): DESIGN, CUSTOMER, INTERNAL, AI_GENERATED
  /// (FEATURE-003 M2, Decision 9 — prep only, no upload endpoint yet).
  category    String?

  uploadedById String?       @db.Uuid
  uploadedBy   StaffProfile? @relation(fields: [uploadedById], references: [id])

  partnerId   String?          @db.Uuid
  partner     BusinessPartner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  quotationId String?          @db.Uuid
  quotation   Quotation?       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  orderId     String?          @db.Uuid
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workOrderId String?          @db.Uuid
  workOrder   WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid

  createdAt       DateTime       @default(now())
  stageInstance   StageInstance? @relation(fields: [stageInstanceId], references: [id])
  stageInstanceId String?        @db.Uuid

  @@index([isDeleted])
  @@index([partnerId])
  @@index([quotationId])
  @@index([orderId])
  @@index([workOrderId])
}

// ---------------------------------------------------------------------------
// Audit log (Requirement 13) — schema only, no write-path yet. Generic
// entityType/entityId reference since it spans every model above; not
// enforced via FK (a formal relation to every model would be impractical).
// ---------------------------------------------------------------------------

model AuditLog {
  id            String        @id @default(uuid()) @db.Uuid
  entityType    String // e.g. "Order", "Quotation", "BusinessPartner", "TreasuryEntry"
  entityId      String        @db.Uuid
  action        AuditAction
  performedById String?       @db.Uuid
  performedBy   StaffProfile? @relation(fields: [performedById], references: [id])
  branchId      String?       @db.Uuid
  branch        Branch?       @relation(fields: [branchId], references: [id])

  // FEATURE-002 pre-M6 (Timeline Preparation / Activity Feed Ready).
  // Denormalized and nullable — NOT a substitute for entityType/entityId,
  // an addition alongside them. Every partner-scoped audit entry
  // (BusinessPartner itself, ContactPerson, PartnerAddress, PartnerNote,
  // Category/Tag assignment, and future Commercial Profile/Attachment
  // events) also carries the owning partner's id here, so a future unified
  // partner Timeline can query `WHERE partnerId = X ORDER BY createdAt`
  // directly in one indexed pass across every entity type, instead of
  // joining per entityType by entityId — which does not scale as entity
  // types grow and would scatter business history across per-type lookups.
  // Left null for non-partner-scoped entries (IAM, auth, settings/catalog
  // CRUD). A formal relation (not a bare UUID like `deletedBy`) is used
  // here deliberately: unlike `deletedBy`, which would need a differently
  // -named relation on StaffProfile for every soft-deletable model, this
  // is the one place a single `partnerId` relation is needed, so the
  // usual FK-relation benefits (referential integrity, `include`
  // ergonomics for the future Timeline) aren't worth giving up.
  partnerId String?          @db.Uuid
  partner   BusinessPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  previousValue Json?
  newValue      Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([partnerId, createdAt])
}
